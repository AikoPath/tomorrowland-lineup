---
import type { GetStaticPaths } from 'astro';
import TimetablePage from '../components/TimetablePage.astro';
import { loadLineup } from '../data/load';

export const getStaticPaths = (async () => {
  const lineup = await loadLineup();
  return lineup.days.map(({ date }) => ({ params: { date }, props: { lineup } }));
}) satisfies GetStaticPaths;

const { lineup } = Astro.props;
---

<TimetablePage lineup={lineup} date={Astro.params.date} />

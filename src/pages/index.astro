---
import PageHeader from '../components/PageHeader.astro';
import TimetablePage from '../components/TimetablePage.astro';
import { loadLineup } from '../data/load';
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site';

const lineup = await loadLineup();
const firstDay = lineup.days[0];
---

{
  firstDay ? (
    <TimetablePage lineup={lineup} date={firstDay.date} />
  ) : (
    <Base title={SITE_NAME} mainPage="lineup">
      <PageHeader lineup={lineup} title="Line-up" />
      <p>The timetable is not available yet.</p>
    </Base>
  )
}

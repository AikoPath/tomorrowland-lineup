---
import type { GetStaticPaths } from 'astro';
import { artistLinks, artistSets, formatDay, formatTime } from '../../artist/artist-page.ts';
import { musicTabs as toMusicTabs } from '../../artist/music-player.ts';
import { photoUrl } from '../../artist/photo.ts';
import FavouriteButton from '../../components/FavouriteButton.astro';
import MusicPlayer from '../../components/MusicPlayer.astro';
import { loadLineup } from '../../data/load.ts';
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../site.ts';
import { artistUrl, editArtistDataUrl } from '../../urls.ts';

export const getStaticPaths = (async () => {
  const lineup = await loadLineup();
  return lineup.artists.map((artist) => ({
    params: { id: artist.id },
    props: { artist, sets: artistSets(lineup, artist.id) },
  }));
}) satisfies GetStaticPaths;

const { artist, sets } = Astro.props;
const socialLinks = artistLinks(artist).social;
// The Listen section has only the player, so a link with no player does not show.
const musicTabs = toMusicTabs(artist).filter((tab) => tab.player);
---

<Base title={`${artist.name} – ${SITE_NAME}`}>
  <div class:list={['page', { 'has-photo': artist.image }]}>
    <nav class="top">
      <a href="/" class="back" aria-label="Back to line-up">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      {
        artist.image && (
          <p class="top-title" aria-hidden="true">
            {artist.name}
          </p>
        )
      }
      <a href={editArtistDataUrl(artist.id)} class="fix" rel="noopener" target="_blank">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M4 20h4L19 9l-4-4L4 16z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        Fix or add info
      </a>
    </nav>

    {
      artist.image && (
        <div class="photo">
          <img src={photoUrl(artist.image, 'large')} data-small-src={photoUrl(artist.image, 'small')} alt="" />
          <h1 class="photo-name">{artist.name}</h1>
        </div>
      )
    }

    <main>
      {
        (!artist.image || artist.genres) && (
          <header>
            {!artist.image && (
              <div class="name">
                <span class="initial" aria-hidden="true">
                  {artist.name.charAt(0)}
                </span>
                <h1>{artist.name}</h1>
              </div>
            )}
            {artist.genres && (
              <ul class="genres">
                {artist.genres.map((genre) => (
                  <li>{genre}</li>
                ))}
              </ul>
            )}
          </header>
        )
      }

      {
        sets.length > 0 && (
          <section>
            <h2>{sets.length === 1 ? 'Set' : 'Sets'}</h2>
            <ul class="sets">
              {sets.map((set) => (
                <li class="set">
                  <div class="set-main">
                    <div class="set-place">
                      <p class="set-day">
                        {formatDay(set.date)} · {set.stage.name}
                      </p>
                      <p class="countdown" data-starts-at={set.start} hidden />
                    </div>
                    <p class="set-time">
                      {formatTime(set.start)}–{formatTime(set.end)}
                    </p>
                    <FavouriteButton class="set-favourite" setKey={set.key} subject="this set" />
                  </div>
                  {set.otherArtists.length > 0 && (
                    <p class="set-b2b">
                      <span class="b2b-tag">B2B</span>
                      {set.otherArtists.map((other, index) => (
                        <>
                          {index > 0 && <span class="b2b-join">&</span>}
                          <a href={artistUrl(other.id)}>{other.name}</a>
                        </>
                      ))}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {musicTabs.length > 0 && <MusicPlayer tabs={musicTabs} />}

      {
        socialLinks.length > 0 && (
          <section>
            <h2>Follow</h2>
            <ul class="links">
              {socialLinks.map((link) => (
                <li>
                  <a href={link.url} class="pill" rel="noopener" target="_blank">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </div>
</Base>

<script>
  import { startsInText } from '../../artist/artist-page.ts';
  import { festivalNow } from '../../now/now-next.ts';
  import { FESTIVAL_TIME_ZONE } from '../../site.ts';

  const countdowns = [...document.querySelectorAll<HTMLElement>('[data-starts-at]')];

  function update() {
    const now = festivalNow(new Date(), FESTIVAL_TIME_ZONE);
    for (const countdown of countdowns) {
      const text = startsInText(countdown.dataset.startsAt!, now);
      countdown.textContent = text ?? '';
      countdown.hidden = !text;
    }
  }

  update();
  setInterval(update, 30_000);

  // The service worker saves the small photo of each artist, but only the large photos that a user opened.
  // With no network, the page shows the saved small photo. With no photo at all, the page shows only the name.
  function showFallbackPhoto(image: HTMLImageElement) {
    const smallSrc = image.dataset.smallSrc;
    if (smallSrc && image.src !== smallSrc) image.src = smallSrc;
    else image.remove();
  }
  const photo = document.querySelector<HTMLImageElement>('.photo img');
  if (photo) {
    photo.addEventListener('error', () => showFallbackPhoto(photo));
    if (photo.complete && photo.naturalWidth === 0) showFallbackPhoto(photo);
  }
</script>

<style>
  .page {
    --photo-height: 380px;

    position: relative;
    max-width: 40rem;
    min-height: calc(100vh - var(--main-nav-height));
    margin: 0 auto;
  }

  .top {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1rem 0;
  }

  /* On a photo, the buttons stay at the top of the screen. After the name scrolls away, a bar with the name shows behind them. */
  .has-photo .top {
    position: fixed;
    /* Above the name on the photo, so that the buttons always get the clicks. */
    z-index: 2;
    top: 0;
    right: 0;
    left: 0;
    max-width: 40rem;
    margin: 0 auto;
    padding-bottom: 1rem;
  }

  .has-photo .top::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-bar-translucent);
    content: '';
  }

  .top-title {
    flex: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    font-size: 1.125rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .has-photo .top::before,
  .top-title {
    opacity: 0;
    visibility: hidden;
  }

  .back,
  .fix {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    justify-content: center;
    height: 2.75rem;
    border: 1px solid var(--color-control-line-strong);
    border-radius: 999px;
    background: var(--color-background);
    text-decoration: none;
  }

  .back {
    width: 2.75rem;
  }

  .has-photo .back {
    border-color: transparent;
  }

  .fix {
    padding: 0 0.875rem;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .back:hover,
  .fix:hover {
    border-color: var(--color-accent);
  }

  .photo {
    position: relative;
    height: var(--photo-height);
    overflow: hidden;
    background: var(--color-surface);
  }

  /* A dark fade at the bottom of the photo makes the name easy to read. */
  .photo::after {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 200px;
    background: linear-gradient(transparent, color-mix(in srgb, var(--color-background) 75%, transparent) 60%, var(--color-background));
    content: '';
  }

  .photo-name {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1rem;
    left: 1.25rem;
    font-size: 2.5rem;
    line-height: 1.05;
    transform-origin: left bottom;
    pointer-events: none;
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* The photo moves at half the speed of the page. */
  @keyframes photo-parallax {
    to {
      transform: translateY(calc(var(--photo-height) / 2));
    }
  }

  @keyframes name-out {
    to {
      opacity: 0;
      transform: translateY(-24px) scale(0.82);
    }
  }

  @keyframes bar-in {
    from {
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
    }

    1% {
      visibility: visible;
    }

    to {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
  }

  @keyframes fade-out {
    to {
      opacity: 0;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      visibility: hidden;
    }

    1% {
      visibility: visible;
    }

    to {
      opacity: 1;
      visibility: visible;
    }
  }

  /*
   * With the "animation" shorthand, the build puts the timeline into the shorthand, and Chromium ignores that rule.
   * The scroll ranges fit a photo height of 380px.
   */
  @supports (animation-timeline: scroll()) {
    .photo img,
    .photo-name,
    .has-photo .top::before,
    .top-title {
      animation-fill-mode: both;
      animation-timeline: scroll(root);
      animation-timing-function: linear;
    }

    .photo img {
      animation-name: photo-parallax;
      animation-range: 0 var(--photo-height);
    }

    .photo-name {
      animation-name: name-out;
      animation-range: 150px 290px;
    }

    .has-photo .top::before,
    .top-title {
      animation-name: bar-in;
      animation-range: 290px 340px;
    }

    @media (prefers-reduced-motion: reduce) {
      .photo img {
        animation-name: none;
      }

      .photo-name {
        animation-name: fade-out;
      }

      .has-photo .top::before,
      .top-title {
        animation-name: fade-in;
      }
    }
  }

  main {
    position: relative;
    display: grid;
    /* With a minimum height, the grid makes the rows taller. The rows keep their own height at the top. */
    align-content: start;
    gap: 1.5rem;
    padding: 1.25rem 1.25rem 3rem;
    background: var(--color-background);
  }

  /* The page can always scroll past the photo, so that the name and the top bar finish their change also on a short page. */
  .has-photo main {
    min-height: 100vh;
    padding-top: 0.25rem;
  }

  header {
    display: grid;
    gap: 0.75rem;
  }

  .name {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .initial {
    display: grid;
    flex: none;
    width: 4.5rem;
    height: 4.5rem;
    place-items: center;
    border: 1px solid var(--color-control-line-strong);
    border-radius: 50%;
    font-size: 1.75rem;
    font-weight: 700;
  }

  h1 {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .name h1 {
    font-size: 1.875rem;
    line-height: 1.15;
    overflow-wrap: anywhere;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .genres,
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .genres li {
    padding: 0.3125rem 0.75rem;
    border: 1px solid var(--color-control-line);
    border-radius: 999px;
    font-size: 0.8125rem;
  }

  section {
    display: grid;
    gap: 0.625rem;
  }

  h2,
  .b2b-tag {
    letter-spacing: 0.125rem;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .sets {
    display: grid;
    gap: 0.5rem;
  }

  .set {
    padding: 0.875rem 1rem;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    background: var(--color-control);
  }

  .set p {
    margin: 0;
  }

  .set-main {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }

  /* The button is larger than the text, so it goes past the padding of the card. */
  .set :global(.set-favourite) {
    margin: -0.375rem -0.5rem -0.375rem 0;
  }

  .set-place {
    flex: 1;
    display: grid;
    gap: 0.1875rem;
  }

  .set-day,
  .set-time {
    font-weight: 700;
  }

  .set-time {
    flex: none;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .countdown {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .countdown[hidden] {
    display: none;
  }

  .set-b2b {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    align-items: center;
    margin-top: 0.75rem !important;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-control-line);
  }

  .b2b-tag {
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--gradient-accent);
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .b2b-join {
    color: var(--color-text-muted);
  }

  .set-b2b a {
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-control-line);
    border-radius: 999px;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .pill:hover,
  .pill:focus-visible {
    border-color: var(--color-control-line-strong);
  }
</style>

---
import {
  artistListEntries,
  filterOptions,
  genreLabel,
  initials,
  listHeading,
  setLabel,
} from '../../artist-list/artist-list.ts';
import { previewPlayer } from '../../artist/music-player.ts';
import { loadLineup } from '../../data/load.ts';
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../site.ts';
import { dateRangeLabel, dayLabel } from '../../timetable/layout.ts';
import { artistUrl } from '../../urls.ts';

/** The number of genre chips that the page shows before the user clicks "More genres". */
const COMMON_GENRE_COUNT = 5;

const lineup = await loadLineup();
const entries = artistListEntries(lineup);
const options = filterOptions(lineup);
const commonGenres = options.genres.slice(0, COMMON_GENRE_COUNT);
const otherGenres = options.genres.slice(COMMON_GENRE_COUNT);
const festivalDates = dateRangeLabel(lineup.days[0].date, lineup.days.at(-1)!.date);
// Escape "<", so that a genre in the data cannot close the script element.
const filterData = JSON.stringify(entries.map((entry) => entry.filter)).replaceAll('<', '\\u003c');
---

<Base title={`Explore · ${SITE_NAME}`}>
  <div class="page">
    <header class="page-header">
      <a href="/" class="back">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
        Timetable
      </a>
      <p class="eyebrow">Tomorrowland Thailand · {festivalDates}</p>
      <h1>Explore</h1>
    </header>

    <form class="filters" role="search" aria-label="Find artists">
      <div class="search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input type="search" name="q" placeholder="Search artists" aria-label="Search artists" autocomplete="off" />
      </div>

      <div class="dropdowns">
        <label class="dropdown">
          <select name="day" aria-label="Day">
            <option value="">Any day</option>
            {options.dates.map((date) => <option value={date}>{dayLabel(date)}</option>)}
          </select>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </label>
        <label class="dropdown">
          <select name="stage" aria-label="Stage">
            <option value="">Any stage</option>
            {options.stages.map((stage) => <option value={stage.id}>{stage.name}</option>)}
          </select>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </label>
      </div>

      {
        options.genres.length > 0 && (
          <div class="chips" role="group" aria-label="Genre">
            <input type="hidden" name="genre" />
            <button type="button" class="chip" data-genre="" aria-pressed="true">
              All
            </button>
            {commonGenres.map((genre) => (
              <button type="button" class="chip" data-genre={genre} aria-pressed="false">
                {genreLabel(genre)}
              </button>
            ))}
            {otherGenres.length > 0 && (
              <>
                <div class="other-genres collapsed" id="other-genres">
                  {otherGenres.map((genre) => (
                    <button type="button" class="chip" data-genre={genre} aria-pressed="false">
                      {genreLabel(genre)}
                    </button>
                  ))}
                </div>
                <button type="button" class="chip more" aria-expanded="false" aria-controls="other-genres">
                  More genres
                </button>
              </>
            )}
          </div>
        )
      }
    </form>

    <main>
      <h2 class="heading" aria-live="polite">{listHeading(entries.length, [])}</h2>
      <p class="empty" hidden>No artist matches the filters.</p>
      <ul class="artists">
        {
          entries.map(({ artist, sets }, index) => {
            const preview = previewPlayer(artist);
            return (
              <li data-index={index}>
                <div class="row">
                  <a href={artistUrl(artist.id)}>
                    {artist.image ? (
                      <img
                        class="photo"
                        src={artist.image}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        data-initials={initials(artist.name)}
                      />
                    ) : (
                      <span class="photo initials" aria-hidden="true">
                        {initials(artist.name)}
                      </span>
                    )}
                    <span class="text">
                      <span class="name">{artist.name}</span>
                      {sets.map((set) => (
                        <span class="set">{setLabel(set)}</span>
                      ))}
                    </span>
                  </a>
                  {preview && (
                    <button
                      type="button"
                      class="play"
                      aria-pressed="false"
                      aria-label={`Play a preview of ${artist.name}`}
                      data-artist={artist.name}
                      data-service={preview.service}
                      data-embed-src={preview.player.kind === 'embed' ? preview.player.src : undefined}
                      data-apple-lookup={preview.player.kind === 'apple-top-song' ? preview.player.lookupUrl : undefined}
                    >
                      <svg class="icon-play" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                      <svg class="icon-stop" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                        <path d="M7 6h4v12H7zM13 6h4v12h-4z"></path>
                      </svg>
                    </button>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </main>
  </div>
  <script is:inline type="application/json" id="artist-filter-data" set:html={filterData} />
</Base>

<script>
  import {
    genreLabel,
    listHeading,
    matchesFilter,
    type ArtistFilter,
    type FilterData,
  } from '../../artist-list/artist-list.ts';
  import { embedUrl, type Player } from '../../artist/music-player.ts';

  const form = document.querySelector<HTMLFormElement>('.filters')!;
  const heading = document.querySelector<HTMLElement>('.heading')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.artists li')];
  const chips = [...form.querySelectorAll<HTMLButtonElement>('.chip[data-genre]')];
  const otherGenres = document.getElementById('other-genres');
  const moreButton = form.querySelector<HTMLButtonElement>('.more');
  const data: FilterData[] = JSON.parse(document.getElementById('artist-filter-data')!.textContent!);
  const fields = ['q', 'day', 'stage', 'genre'] as const;

  function field(name: (typeof fields)[number]) {
    return form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
  }

  function selectedText(name: 'day' | 'stage'): string | undefined {
    const select = field(name) as HTMLSelectElement | null;
    return select?.value ? select.selectedOptions[0]?.textContent ?? undefined : undefined;
  }

  // The URL keeps the filters, so that a user can share a filtered list.
  const params = new URLSearchParams(location.search);
  for (const name of fields) {
    const input = field(name);
    const value = params.get(name);
    if (input && value) input.value = value;
  }

  function showOtherGenres(show: boolean) {
    if (!otherGenres || !moreButton) return;
    otherGenres.classList.toggle('collapsed', !show);
    moreButton.setAttribute('aria-expanded', String(show));
    moreButton.textContent = show ? 'Fewer genres' : 'More genres';
  }

  function applyFilter() {
    const filter: ArtistFilter = {
      query: field('q')?.value ?? '',
      date: field('day')?.value ?? '',
      stage: field('stage')?.value ?? '',
      genre: field('genre')?.value ?? '',
    };

    for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset.genre === filter.genre));

    let shown = 0;
    items.forEach((item, index) => {
      const match = matchesFilter(data[index], filter);
      item.hidden = !match;
      if (match) shown += 1;
      else stopPreview(item);
    });
    const activeFilters = [selectedText('day'), selectedText('stage'), filter.genre && genreLabel(filter.genre)];
    heading.textContent = listHeading(shown, activeFilters.filter((label): label is string => Boolean(label)));
    empty.hidden = shown > 0;

    const url = new URL(location.href);
    for (const name of fields) {
      const value = field(name)?.value.trim();
      if (value) url.searchParams.set(name, value);
      else url.searchParams.delete(name);
    }
    history.replaceState(null, '', url);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      field('genre')!.value = chip.dataset.genre ?? '';
      applyFilter();
    });
  }
  moreButton?.addEventListener('click', () => showOtherGenres(Boolean(otherGenres?.classList.contains('collapsed'))));

  const playerTitles: Record<string, string> = {
    spotify: 'Spotify player',
    apple_music: 'Apple Music player',
    youtube: 'YouTube player',
    soundcloud: 'SoundCloud player',
  };

  // Only one preview plays at a time.
  let playingItem: HTMLLIElement | undefined;

  function stopPreview(item: HTMLLIElement) {
    item.querySelector('.preview')?.remove();
    const button = item.querySelector<HTMLButtonElement>('.play');
    if (button) {
      button.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-label', `Play a preview of ${button.dataset.artist}`);
    }
    if (playingItem === item) playingItem = undefined;
  }

  async function startPreview(item: HTMLLIElement, button: HTMLButtonElement) {
    if (playingItem) stopPreview(playingItem);
    playingItem = item;
    button.setAttribute('aria-pressed', 'true');
    button.setAttribute('aria-label', `Stop the preview of ${button.dataset.artist}`);

    const service = button.dataset.service ?? '';
    const preview = document.createElement('div');
    preview.className = 'preview';
    preview.dataset.service = service;
    item.append(preview);

    const { embedSrc, appleLookup } = button.dataset;
    const player: Player = appleLookup
      ? { kind: 'apple-top-song', lookupUrl: appleLookup }
      : { kind: 'embed', src: embedSrc! };
    if (appleLookup) preview.textContent = 'Loading the top song…';
    const src = await embedUrl(player);
    // The user can stop the preview or start another preview during the lookup.
    if (!preview.isConnected) return;
    if (!src) {
      preview.textContent = 'Apple Music did not give a song for this artist.';
      return;
    }

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = playerTitles[service] ?? 'Music player';
    iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
    preview.replaceChildren(iframe);
  }

  for (const item of items) {
    const button = item.querySelector<HTMLButtonElement>('.play');
    button?.addEventListener('click', () => {
      if (playingItem === item) stopPreview(item);
      else void startPreview(item, button);
    });
  }

  // Some image links in the data have a format that a browser cannot show, for example a Photoshop file.
  function showInitials(image: HTMLImageElement) {
    const span = document.createElement('span');
    span.className = 'photo initials';
    // Astro scopes the styles of the page with a data attribute, so the new element needs the same attribute.
    for (const { name, value } of image.attributes) {
      if (name.startsWith('data-astro-cid')) span.setAttribute(name, value);
    }
    span.setAttribute('aria-hidden', 'true');
    span.textContent = image.dataset.initials ?? '';
    image.replaceWith(span);
  }

  for (const image of document.querySelectorAll<HTMLImageElement>('.artists img.photo')) {
    // The image can fail before this script runs.
    if (image.complete && image.naturalWidth === 0) showInitials(image);
    else image.addEventListener('error', () => showInitials(image));
  }

  form.addEventListener('input', applyFilter);
  form.addEventListener('submit', (event) => event.preventDefault());
  // The browser can restore the form values when the user comes back to the page.
  window.addEventListener('pageshow', applyFilter);
  applyFilter();
</script>

<style>
  .page {
    --color-icon: color-mix(in srgb, var(--color-text) 70%, var(--color-background));

    max-width: 52rem;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .page-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.375rem;
    padding: 0 1.25rem;
  }

  .back {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .eyebrow {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.1;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem 0;
  }

  .search,
  .dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search svg,
  .dropdown svg {
    fill: none;
    stroke: var(--color-icon);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .search svg {
    position: absolute;
    left: 0.875rem;
    pointer-events: none;
  }

  .dropdown svg {
    position: absolute;
    right: 0.875rem;
    pointer-events: none;
  }

  input,
  select {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    background: var(--color-control);
    color: inherit;
    font: inherit;
  }

  input {
    height: 3rem;
    padding: 0 0.875rem 0 2.625rem;
    font-size: 1rem;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  select {
    height: 2.75rem;
    padding: 0 2.5rem 0 0.875rem;
    font-size: 0.875rem;
    appearance: none;
    cursor: pointer;
  }

  option {
    background: var(--color-background);
  }

  input:focus,
  select:focus {
    border-color: var(--color-accent);
  }

  .dropdowns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .chips,
  .other-genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .other-genres {
    display: contents;
  }

  /* The collapsed list shows only the selected genre, so that the selected chip is always visible. */
  .other-genres.collapsed .chip:not([aria-pressed='true']) {
    display: none;
  }

  .chip {
    height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-control-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .chip:hover {
    color: var(--color-text);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
    font-weight: 700;
  }

  .heading {
    margin: 0;
    padding: 1.25rem 1.25rem 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .empty {
    margin: 0.5rem 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .artists {
    border-top: 1px solid var(--color-divider);
  }

  .artists li {
    border-bottom: 1px solid var(--color-divider);
  }

  .artists li[hidden] {
    display: none;
  }

  .row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.5rem 1.25rem;
  }

  .row a {
    display: flex;
    flex-grow: 1;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    min-height: 3rem;
    text-decoration: none;
  }

  .row a:hover .name,
  .row a:focus-visible .name {
    color: var(--color-accent);
  }

  .photo {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
  }

  img.photo {
    background: var(--color-control);
    object-fit: cover;
    object-position: top;
  }

  .initials {
    display: grid;
    place-items: center;
    border: 1px solid color-mix(in srgb, var(--color-text) 40%, transparent);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
  }

  .name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .set {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .play {
    display: grid;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .play svg {
    fill: currentColor;
    stroke: none;
  }

  .play[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-background);
  }

  .play[aria-pressed='false'] .icon-stop,
  .play[aria-pressed='true'] .icon-play {
    display: none;
  }

  .artists :global(.preview) {
    padding: 0 1.25rem 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .artists :global(.preview iframe) {
    display: block;
    width: 100%;
    height: 152px;
    border: 0;
    border-radius: 0.75rem;
  }

  .artists :global(.preview[data-service='youtube'] iframe) {
    height: auto;
    aspect-ratio: 16 / 9;
  }

  .artists :global(.preview[data-service='soundcloud'] iframe) {
    height: 166px;
  }

  .artists :global(.preview[data-service='apple_music'] iframe) {
    height: 175px;
  }
</style>

---
import {
  artistListEntries,
  filterOptions,
  genreLabel,
  initials,
  listHeading,
  setLabel,
} from '../../artist-list/artist-list.ts';
import { musicLabels, type MusicKey } from '../../artist/artist-page.ts';
import { previewPlayers } from '../../artist/music-player.ts';
import { photoUrl } from '../../artist/photo.ts';
import FavouriteButton from '../../components/FavouriteButton.astro';
import PageHeader from '../../components/PageHeader.astro';
import PlatformIcon from '../../components/PlatformIcon.astro';
import { loadLineup } from '../../data/load.ts';
import Base from '../../layouts/Base.astro';
import { SITE_NAME } from '../../site.ts';
import { dayLabel } from '../../timetable/layout.ts';
import { artistUrl } from '../../urls.ts';

/** The number of genre chips that the page shows before the user clicks "More genres". */
const COMMON_GENRE_COUNT = 5;

const lineup = await loadLineup();
const entries = artistListEntries(lineup);
const options = filterOptions(lineup);
const commonGenres = options.genres.slice(0, COMMON_GENRE_COUNT);
const otherGenres = options.genres.slice(COMMON_GENRE_COUNT);
// Escape "<", so that a genre in the data cannot close the script element.
const musicServices = Object.entries(musicLabels) as [MusicKey, string][];
const filterData = JSON.stringify(entries.map((entry) => entry.filter)).replaceAll('<', '\\u003c');
---

<Base title={`Explore · ${SITE_NAME}`} mainPage="explore">
  <div class="page">
    <div class="header">
      <PageHeader lineup={lineup} title="Explore" />
    </div>

    <form class="filters" role="search" aria-label="Find artists">
      <div class="search">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input type="search" name="q" placeholder="Search artists" aria-label="Search artists" autocomplete="off" />
      </div>

      <div class="dropdowns">
        <label class="dropdown">
          <select name="day" aria-label="Day">
            <button type="button"><selectedcontent></selectedcontent></button>
            <option value="">Any day</option>
            {options.dates.map((date) => <option value={date}>{dayLabel(date)}</option>)}
          </select>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </label>
        <label class="dropdown">
          <select name="stage" aria-label="Stage">
            <button type="button"><selectedcontent></selectedcontent></button>
            <option value="">Any stage</option>
            {options.stages.map((stage) => <option value={stage.id}>{stage.name}</option>)}
          </select>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </label>
      </div>

      {
        options.genres.length > 0 && (
          <div class="chips" role="group" aria-label="Genre">
            <button type="button" class="chip" data-genre="" aria-pressed="true">
              All
            </button>
            {commonGenres.map((genre) => (
              <button type="button" class="chip" data-genre={genre} aria-pressed="false">
                {genreLabel(genre)}
              </button>
            ))}
            {otherGenres.length > 0 && (
              <>
                <div class="other-genres collapsed" id="other-genres">
                  {otherGenres.map((genre) => (
                    <button type="button" class="chip" data-genre={genre} aria-pressed="false">
                      {genreLabel(genre)}
                    </button>
                  ))}
                </div>
                <button type="button" class="chip more" aria-expanded="false" aria-controls="other-genres">
                  More genres
                </button>
              </>
            )}
          </div>
        )
      }
    </form>

    <main>
      <div class="list-bar">
        <h2 class="heading" aria-live="polite">{listHeading(entries.length, [])}</h2>
        {/* A preference, not a filter: it is not in the form, so it is not in the URL. */}
        <label class="dropdown service">
          {/* "▶ plays on Spotify" tells the user that the icon on the photos is a play button. */}
          <span class="service-label">
            <span class="play-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="9" height="9"><path d="M8 5v14l11-7z"></path></svg>
            </span>
            plays on
          </span>
          <select name="music-service" aria-label="Play previews on">
            <button type="button"><selectedcontent></selectedcontent></button>
            {
              musicServices.map(([key, label]) => (
                <option value={key}>
                  <PlatformIcon platform={key} />
                  <span>{label}</span>
                </option>
              ))
            }
          </select>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 9l6 6 6-6"></path></svg>
        </label>
      </div>
      <p class="empty" hidden>No artist matches the filters.</p>
      <ul class="artists">
        {
          entries.map(({ artist, sets }, index) => {
            const players = previewPlayers(artist);
            return (
              <li data-index={index}>
                <div class="row">
                  <div class="media">
                    {/* The text link is the link for keyboards and screen readers. The photo is a second target for a click. */}
                    <a href={artistUrl(artist.id)} tabindex="-1" aria-hidden="true">
                      {artist.image ? (
                        <img
                          class="photo"
                          src={photoUrl(artist.image, 'small')}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          data-initials={initials(artist.name)}
                        />
                      ) : (
                        <span class="photo initials">{initials(artist.name)}</span>
                      )}
                    </a>
                    {players.length > 0 && (
                      <button
                        type="button"
                        class="play"
                        aria-pressed="false"
                        aria-label={`Play a preview of ${artist.name}`}
                        data-artist={artist.name}
                        data-players={JSON.stringify(players)}
                      >
                        <svg class="icon-play" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                          <path d="M8 5v14l11-7z"></path>
                        </svg>
                        <svg class="icon-stop" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                          <path d="M7 6h4v12H7zM13 6h4v12h-4z"></path>
                        </svg>
                      </button>
                    )}
                  </div>
                  <a href={artistUrl(artist.id)} class="text">
                    <span class="name">{artist.name}</span>
                    {sets.map((set) => (
                      <span class="set">{setLabel(set)}</span>
                    ))}
                    {artist.genres && (
                      <span class="genres" title={artist.genres.map(genreLabel).join(' · ')}>
                        {artist.genres.map(genreLabel).join(' · ')}
                      </span>
                    )}
                  </a>
                  {sets.length > 0 && <FavouriteButton setKey={sets.map((set) => set.key)} subject={artist.name} />}
                </div>
              </li>
            );
          })
        }
      </ul>
    </main>
  </div>
  <script is:inline type="application/json" id="artist-filter-data" set:html={filterData} />
</Base>

<script>
  import {
    genresLabel,
    listHeading,
    matchesFilter,
    type ArtistFilter,
    type FilterData,
  } from '../../artist-list/artist-list.ts';
  import { musicLabels, type MusicKey } from '../../artist/artist-page.ts';
  import {
    choosePreview,
    embedUrl,
    readMusicService,
    saveMusicService,
    spotifyUri,
    type PreviewPlayer,
  } from '../../artist/music-player.ts';
  import { playSpotify } from '../../artist/spotify-iframe-api.ts';

  const form = document.querySelector<HTMLFormElement>('.filters')!;
  const heading = document.querySelector<HTMLElement>('.heading')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const items = [...document.querySelectorAll<HTMLLIElement>('.artists li')];
  const chips = [...form.querySelectorAll<HTMLButtonElement>('.chip[data-genre]')];
  const otherGenres = document.getElementById('other-genres');
  const moreButton = form.querySelector<HTMLButtonElement>('.more');
  const data: FilterData[] = JSON.parse(document.getElementById('artist-filter-data')!.textContent!);
  const fields = ['q', 'day', 'stage'] as const;
  const genreParam = 'genre';
  // The user can select more genres. An empty set shows the artists of all genres.
  const selectedGenres = new Set<string>();

  function field(name: (typeof fields)[number]) {
    return form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
  }

  function selectedText(name: 'day' | 'stage'): string | undefined {
    const select = field(name) as HTMLSelectElement | null;
    return select?.value ? select.selectedOptions[0]?.textContent ?? undefined : undefined;
  }

  // The URL keeps the filters, so that a user can share a filtered list.
  const params = new URLSearchParams(location.search);
  for (const name of fields) {
    const input = field(name);
    const value = params.get(name);
    if (input && value) input.value = value;
  }
  for (const genre of params.getAll(genreParam)) {
    if (chips.some((chip) => chip.dataset.genre === genre)) selectedGenres.add(genre);
  }

  function showOtherGenres(show: boolean) {
    if (!otherGenres || !moreButton) return;
    otherGenres.classList.toggle('collapsed', !show);
    moreButton.setAttribute('aria-expanded', String(show));
    moreButton.textContent = show ? 'Fewer genres' : 'More genres';
  }

  function applyFilter() {
    const filter: ArtistFilter = {
      query: field('q')?.value ?? '',
      date: field('day')?.value ?? '',
      stage: field('stage')?.value ?? '',
      genres: [...selectedGenres],
    };

    for (const chip of chips) {
      const genre = chip.dataset.genre ?? '';
      chip.setAttribute('aria-pressed', String(genre ? selectedGenres.has(genre) : selectedGenres.size === 0));
    }

    let shown = 0;
    items.forEach((item, index) => {
      const match = matchesFilter(data[index], filter);
      item.hidden = !match;
      if (match) shown += 1;
      else stopPreview(item);
    });
    const activeFilters = [
      selectedText('day'),
      selectedText('stage'),
      filter.genres.length > 0 && genresLabel(filter.genres),
    ];
    heading.textContent = listHeading(shown, activeFilters.filter((label): label is string => Boolean(label)));
    empty.hidden = shown > 0;

    const url = new URL(location.href);
    for (const name of fields) {
      const value = field(name)?.value.trim();
      if (value) url.searchParams.set(name, value);
      else url.searchParams.delete(name);
    }
    url.searchParams.delete(genreParam);
    for (const genre of selectedGenres) url.searchParams.append(genreParam, genre);
    history.replaceState(null, '', url);
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const genre = chip.dataset.genre ?? '';
      // The "All" chip clears the selection. A genre chip adds the genre or removes it.
      if (!genre) selectedGenres.clear();
      else if (selectedGenres.has(genre)) selectedGenres.delete(genre);
      else selectedGenres.add(genre);
      applyFilter();
    });
  }
  moreButton?.addEventListener('click', () => showOtherGenres(Boolean(otherGenres?.classList.contains('collapsed'))));

  const playerTitles: Record<string, string> = {
    spotify: 'Spotify player',
    apple_music: 'Apple Music player',
    youtube: 'YouTube player',
    soundcloud: 'SoundCloud player',
  };

  /** The compact form of the Spotify player. */
  const SPOTIFY_PLAYER_HEIGHT = 152;

  const serviceSelect = document.querySelector<HTMLSelectElement>('select[name="music-service"]')!;
  let chosenService = readMusicService(localStorage);
  if (chosenService) serviceSelect.value = chosenService;

  function previewOf(button: HTMLButtonElement): PreviewPlayer | undefined {
    const players: PreviewPlayer[] = JSON.parse(button.dataset.players ?? '[]');
    return choosePreview(players, chosenService);
  }

  // Only one preview plays at a time.
  let playingItem: HTMLLIElement | undefined;
  let playingService: MusicKey | undefined;

  function stopPreview(item: HTMLLIElement) {
    item.querySelector('.preview')?.remove();
    const button = item.querySelector<HTMLButtonElement>('.play');
    if (button) {
      button.setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-label', `Play a preview of ${button.dataset.artist}`);
    }
    if (playingItem === item) {
      playingItem = undefined;
      playingService = undefined;
    }
  }

  async function startPreview(item: HTMLLIElement, button: HTMLButtonElement) {
    if (playingItem) stopPreview(playingItem);
    const choice = previewOf(button);
    if (!choice) return;
    const { service, player } = choice;
    playingItem = item;
    playingService = service;
    button.setAttribute('aria-pressed', 'true');
    button.setAttribute('aria-label', `Stop the preview of ${button.dataset.artist}`);

    const preview = document.createElement('div');
    preview.className = 'preview';
    preview.dataset.service = service;
    if (chosenService && service !== chosenService) {
      const note = document.createElement('p');
      note.className = 'fallback';
      note.textContent = `${button.dataset.artist} has no ${musicLabels[chosenService]} player. This is ${musicLabels[service]}.`;
      preview.append(note);
    }
    // The players replace the content of the slot, so the note stays.
    const slot = document.createElement('div');
    preview.append(slot);
    item.append(preview);

    const uri = spotifyUri(player);
    if (uri) {
      const started = await playSpotify(slot, uri, SPOTIFY_PLAYER_HEIGHT, playerTitles.spotify!).then(
        () => true,
        () => false,
      );
      if (started) return;
      // The API can fail to load, for example because of a content blocker. The embed then needs a click on "Play".
      if (!preview.isConnected) return;
    }

    if (player.kind === 'apple-top-song') slot.textContent = 'Loading the top song…';
    const src = await embedUrl(player.kind === 'embed' ? { ...player, src: player.autoplaySrc ?? player.src } : player);
    // The user can stop the preview or start another preview during the lookup.
    if (!preview.isConnected) return;
    if (!src) {
      slot.textContent = 'Apple Music did not give a song for this artist.';
      return;
    }

    const iframe = document.createElement('iframe');
    iframe.src = src;
    iframe.title = playerTitles[service] ?? 'Music player';
    iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
    slot.replaceChildren(iframe);
  }

  for (const item of items) {
    const button = item.querySelector<HTMLButtonElement>('.play');
    button?.addEventListener('click', () => {
      if (playingItem === item) stopPreview(item);
      else void startPreview(item, button);
    });
  }

  serviceSelect.addEventListener('change', () => {
    chosenService = serviceSelect.value as MusicKey;
    saveMusicService(localStorage, chosenService);
    // The preview that plays changes to the new service, when the artist has a player for it.
    const button = playingItem?.querySelector<HTMLButtonElement>('.play');
    if (playingItem && button && previewOf(button)?.service !== playingService) void startPreview(playingItem, button);
  });

  // Some image links in the data have a format that a browser cannot show, for example a Photoshop file.
  function showInitials(image: HTMLImageElement) {
    const span = document.createElement('span');
    span.className = 'photo initials';
    // Astro scopes the styles of the page with a data attribute, so the new element needs the same attribute.
    for (const { name, value } of image.attributes) {
      if (name.startsWith('data-astro-cid')) span.setAttribute(name, value);
    }
    span.setAttribute('aria-hidden', 'true');
    span.textContent = image.dataset.initials ?? '';
    image.replaceWith(span);
  }

  for (const image of document.querySelectorAll<HTMLImageElement>('.artists img.photo')) {
    // The image can fail before this script runs.
    if (image.complete && image.naturalWidth === 0) showInitials(image);
    else image.addEventListener('error', () => showInitials(image));
  }

  form.addEventListener('input', applyFilter);
  form.addEventListener('submit', (event) => event.preventDefault());
  // The browser can restore the form values when the user comes back to the page.
  window.addEventListener('pageshow', applyFilter);
  applyFilter();
</script>

<style>
  .page {
    --color-icon: color-mix(in srgb, var(--color-text) 70%, var(--color-background));

    max-width: 52rem;
    margin: 0 auto;
    padding-top: 1.75rem;
  }

  .header {
    padding: 0 1.25rem;
  }

  .filters {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.25rem 0;
  }

  .search,
  .dropdown {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search svg,
  .dropdown > svg {
    fill: none;
    stroke: var(--color-icon);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .search svg {
    position: absolute;
    left: 0.875rem;
    pointer-events: none;
  }

  .dropdown > svg {
    position: absolute;
    right: 0.875rem;
    pointer-events: none;
  }

  input,
  select {
    width: 100%;
    min-width: 0;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    background: var(--color-control);
    color: inherit;
    font: inherit;
  }

  input {
    height: 3rem;
    padding: 0 0.875rem 0 2.625rem;
    font-size: 1rem;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  select {
    height: 2.75rem;
    padding: 0 2.5rem 0 0.875rem;
    font-size: 0.875rem;
    appearance: none;
    cursor: pointer;
  }

  option {
    background: var(--color-background);
  }

  /* Browsers with a customizable select show the open list in the theme. Other browsers show their own list. */
  @supports (appearance: base-select) {
    select,
    ::picker(select) {
      appearance: base-select;
    }

    select {
      display: flex;
      align-items: center;
    }

    selectedcontent {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    select::picker-icon {
      display: none;
    }

    ::picker(select) {
      margin-top: 0.375rem;
      padding: 0.25rem;
      border: 1px solid var(--color-control-line);
      border-radius: 0.5rem;
      background: var(--color-card);
      box-shadow: var(--shadow-popover);
    }

    option {
      min-height: 2.75rem;
      padding: 0 0.75rem;
      border-radius: 0.375rem;
      background: none;
    }

    option:hover {
      background: var(--color-control);
    }

    option:checked {
      color: var(--color-accent);
      font-weight: 700;
    }
  }

  input:focus,
  select:focus {
    border-color: var(--color-accent);
  }

  .dropdowns {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .chips,
  .other-genres {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .other-genres {
    display: contents;
  }

  /* The collapsed list shows only the selected genres, so that the selected chips are always visible. */
  .other-genres.collapsed .chip:not([aria-pressed='true']) {
    display: none;
  }

  .chip {
    height: 2.75rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-control-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .chip:hover {
    color: var(--color-text);
  }

  .chip[aria-pressed='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
    font-weight: 700;
  }

  .list-bar {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1.25rem 0.5rem;
  }

  .heading {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service {
    flex: none;
    gap: 0.5rem;
  }

  .service-label {
    display: inline-flex;
    gap: 0.375rem;
    align-items: center;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .service select {
    height: 2.25rem;
    padding-left: 0.625rem;
  }

  .service > svg {
    right: 0.625rem;
  }

  /* The icon of the service shows in the open list and in the button. A browser with no customizable select shows only the text. */
  .service option,
  .service selectedcontent {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .service option :global(svg),
  .service selectedcontent :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .empty {
    margin: 0.5rem 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .artists {
    border-top: 1px solid var(--color-divider);
  }

  .artists li {
    border-bottom: 1px solid var(--color-divider);
  }

  .artists li[hidden] {
    display: none;
  }

  .row {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.5rem 1.25rem;
  }

  /* The design puts the heart at the right end of the row, with a smaller space after it. */
  .row:has(:global(.favourite)) {
    padding-right: 0.5rem;
  }

  .media {
    position: relative;
    flex: none;
  }

  .media a {
    display: block;
    text-decoration: none;
  }

  .photo {
    display: block;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
  }

  img.photo {
    background: var(--color-control);
    object-fit: cover;
    object-position: top;
  }

  .initials {
    display: grid;
    place-items: center;
    border: 1px solid var(--color-control-line);
    background: var(--color-control);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  /* The play button covers the lower part of the tile, so the initials move up. */
  .media:has(.play) .initials {
    place-items: start center;
    padding-top: 0.25rem;
  }

  .text {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    gap: 0.1875rem;
    min-width: 0;
    text-decoration: none;
  }

  .text:hover .name,
  .text:focus-visible .name {
    color: var(--color-accent);
  }

  .name {
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .set {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  /* A quiet line: one line with "…" at the end when the genres do not fit. */
  .genres {
    overflow: hidden;
    color: color-mix(in srgb, var(--color-text) 55%, transparent);
    font-size: 0.75rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* A round button on the lower right part of the photo, as in the design. */
  .play,
  .play-badge {
    display: grid;
    width: 1.5rem;
    height: 1.5rem;
    flex: none;
    place-items: center;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-background);
  }

  /* Smaller than the play buttons, so that it does not look like a button. */
  .play-badge {
    width: 1.125rem;
    height: 1.125rem;
  }

  .play {
    position: absolute;
    right: 0.25rem;
    bottom: 0.25rem;
    padding: 0;
    border: 0;
    cursor: pointer;
  }

  /* The visible circle is small, so a larger invisible area receives the touch. */
  .play::before {
    position: absolute;
    inset: -0.625rem;
    content: '';
  }


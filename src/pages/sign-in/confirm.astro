---
// The link in the sign-in email opens this page. See supabase/templates/sign-in.html.
import SignInScreen from '../../components/SignInScreen.astro';
import { SIGN_IN_URL } from '../../urls.ts';
---

<SignInScreen>
  <p class="progress" role="status">Sign-in in progress.</p>
  <p class="error" role="alert" hidden>
    The sign-in link is not valid. A link works one time and for one hour only. <a href={SIGN_IN_URL}
      >Send a new link</a
    >
  </p>
  <div class="question" hidden>
    <p>
      You are signed in as <strong class="email"></strong>. This device did not ask for this link. Continue only if this
      is your account. Then the favourites on this device go to this account.
    </p>
    <button type="button" class="primary continue">Continue</button>
    <button type="button" class="secondary sign-out">Sign out</button>
  </div>
</SignInScreen>

<script>
  import { isOwnSignIn, takeSignInRequest } from '../../account/sign-in-request.ts';
  import { addDeviceFavouritesToPending, syncFavourites } from '../../favourites/sync.ts';
  import { SIGN_IN_URL } from '../../urls.ts';

  const tokenHash = new URLSearchParams(location.search).get('token_hash');
  // The token must not stay in the browser history.
  history.replaceState(null, '', location.pathname);
  const requestedEmail = takeSignInRequest(localStorage);

  const progress = document.querySelector<HTMLElement>('.progress')!;
  const question = document.querySelector<HTMLElement>('.question')!;

  try {
    if (!tokenHash) throw new Error('The link has no token.');
    const { confirmSignIn, favouriteAccount, signOut, signedInEmail } = await import('../../account/supabase.ts');
    await confirmSignIn(tokenHash);

    async function addFavourites() {
      addDeviceFavouritesToPending(localStorage);
      // With no network connection, the favourites stay pending. The next page sends them.
      await syncFavourites(localStorage, favouriteAccount).catch(() => {});
      location.replace(SIGN_IN_URL);
    }

    const email = await signedInEmail();
    if (isOwnSignIn(requestedEmail, email)) {
      await addFavourites();
    } else {
      // The link can come from a different person. The favourites go to the account only after the user agrees.
      progress.hidden = true;
      question.querySelector('.email')!.textContent = email;
      question.hidden = false;
      question.querySelector('.continue')!.addEventListener('click', addFavourites);
      question.querySelector('.sign-out')!.addEventListener('click', async () => {
        await signOut();
        location.replace(SIGN_IN_URL);
      });
    }
  } catch {
    progress.hidden = true;
    question.hidden = true;
    document.querySelector<HTMLElement>('.error')!.hidden = false;
  }
</script>

<style>
  p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  a {
    color: var(--color-accent);
    font-weight: 700;
  }

  .question {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .question[hidden] {
    display: none;
  }

  .question p {
    color: var(--color-text);
  }

  button {
    height: 3rem;
    border-radius: 100px;
    color: var(--color-text);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .primary {
    border: 0;
    background: var(--gradient-accent);
  }

  .secondary {
    border: 1px solid var(--color-control-line-strong);
    background: transparent;
  }
</style>

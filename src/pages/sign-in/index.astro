---
import { ACCOUNT_AVAILABLE } from '../../account/available.ts';
import SignInScreen from '../../components/SignInScreen.astro';
import { LINEUP_URL } from '../../urls.ts';
---

<SignInScreen>
  <p class="intro">
    Your favourites are saved on this device. Sign in if you want to keep them when you change phone or clear your
    browser.
  </p>
  {
    ACCOUNT_AVAILABLE ? (
      <>
        <form class="send">
          <div class="field">
            <label for="email">Email address</label>
            <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
          </div>
          <button type="submit" class="primary">
            Send sign-in link
          </button>
          <p class="note">We email you a link. No password needed.</p>
          <p class="error" role="alert" hidden />
        </form>
        <div class="sent" role="status" hidden>
          <p>
            We sent a sign-in link to <strong class="email" />. Open the link on this device. Then the favourites on
            this device go to your account.
          </p>
          <button type="button" class="secondary change-email">
            Use a different email address
          </button>
        </div>
        <div class="signed-in" hidden>
          <p>
            You are signed in as <strong class="email" />. Your favourites stay the same on all your devices.
          </p>
          <button type="button" class="secondary sign-out">
            Sign out
          </button>
        </div>
      </>
    ) : (
      <p>Sign-in is not available on this copy of the site.</p>
    )
  }
  <div class="footer" slot="footer">
    <a href={LINEUP_URL} data-close>Not now</a>
  </div>
</SignInScreen>

<script>
  import { ACCOUNT_AVAILABLE } from '../../account/available.ts';
  import { hasSession } from '../../account/session.ts';
  import { clearPending } from '../../favourites/sync.ts';

  const form = document.querySelector<HTMLFormElement>('form.send');
  if (ACCOUNT_AVAILABLE && form) {
    const intro = document.querySelector<HTMLElement>('.intro')!;
    const sent = document.querySelector<HTMLElement>('.sent')!;
    const signedIn = document.querySelector<HTMLElement>('.signed-in')!;
    const footer = document.querySelector<HTMLElement>('.footer')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const submit = form.querySelector<HTMLButtonElement>('button')!;
    const error = form.querySelector<HTMLElement>('.error')!;

    function show(state: 'form' | 'sent' | 'signed-in', email = '') {
      form!.hidden = state !== 'form';
      sent.hidden = state !== 'sent';
      signedIn.hidden = state !== 'signed-in';
      intro.hidden = state === 'signed-in';
      footer.hidden = state === 'signed-in';
      for (const element of document.querySelectorAll('.email')) element.textContent = email;
    }

    // A user who is not signed in does not download the Supabase client before the click.
    const account = () => import('../../account/supabase.ts');

    if (hasSession(localStorage)) {
      const email = await (await account()).signedInEmail();
      if (email) show('signed-in', email);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      submit.disabled = true;
      try {
        await (await account()).sendSignInLink(input.value);
        show('sent', input.value);
      } catch (cause) {
        error.textContent =
          (cause as { status?: number }).status === 429
            ? 'You asked for too many links. Wait some minutes, then try again.'
            : 'We could not send the link. Make sure that you have a network connection, then try again.';
        error.hidden = false;
      } finally {
        submit.disabled = false;
      }
    });

    sent.querySelector('.change-email')!.addEventListener('click', () => {
      show('form');
      input.focus();
    });

    signedIn.querySelector('.sign-out')!.addEventListener('click', async () => {
      // The favourites stay on this device. The changes that the account does not have yet go away.
      clearPending(localStorage);
      await (await account()).signOut();
      show('form');
    });
  }
</script>

<style>
  p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  .intro,
  .note {
    color: var(--color-text-muted);
  }

  .note {
    font-size: 0.8125rem;
  }

  form,
  .sent,
  .signed-in {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  [hidden] {
    display: none !important;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  label {
    font-size: 0.875rem;
    font-weight: 700;
  }

  input {
    width: 100%;
    height: 3rem;
    padding: 0 0.875rem;
    border: 1px solid var(--color-control-line-strong);
    border-radius: 0.5rem;
    background: var(--color-control);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
  }

  input::placeholder {
    color: var(--color-text-muted);
  }

  button {
    height: 3rem;
    border-radius: 100px;
    color: var(--color-text);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .primary {
    border: 0;
    background: var(--gradient-accent);
  }

  .primary:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .secondary {
    border: 1px solid var(--color-control-line-strong);
    background: transparent;
  }

  .error {
    color: var(--color-accent);
    font-size: 0.875rem;
  }

  .footer {
    display: flex;
    justify-content: center;
    margin-top: auto;
    padding: 0 1.25rem 1.5rem;
  }

  .footer a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }
</style>

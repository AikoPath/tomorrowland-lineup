---
import FavouriteButton from '../components/FavouriteButton.astro';
import PageHeader from '../components/PageHeader.astro';
import { loadLineup } from '../data/load.ts';
import Base from '../layouts/Base.astro';
import { initials } from '../now/now-next.ts';
import { SITE_NAME } from '../site.ts';
import { timelineDays } from '../timeline/timeline.ts';
import { dayLabelParts } from '../timetable/layout.ts';
import { ACCOUNT_AVAILABLE } from '../account/available.ts';
import { LINEUP_URL, SIGN_IN_URL, artistUrl } from '../urls.ts';

const lineup = await loadLineup();
const days = timelineDays(lineup);
const clockTime = (localTime: string) => localTime.slice(11, 16);
---

<Base title={`My timeline · ${SITE_NAME}`} mainPage="timeline">
  <div class="page">
    <div class="top">
      <PageHeader lineup={lineup} title="My timeline">
        <span slot="eyebrow" class="count" aria-live="polite"></span>
      </PageHeader>

      {
        days.length > 0 && (
          <div class="days" role="tablist" aria-label="Festival days">
            {days.map(({ date, end }) => {
              const { weekday, dayAndMonth } = dayLabelParts(date);
              return (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${date}`}
                  aria-controls={`day-${date}`}
                  aria-selected="false"
                  data-date={date}
                  data-end={end}
                >
                  <span class="weekday">{weekday}</span>
                  <span class="date">{dayAndMonth}</span>
                </button>
              );
            })}
          </div>
        )
      }

      <div class="device-note">
        <p>Saved on this device only.</p>
        {
          ACCOUNT_AVAILABLE && (
            <>
              <a class="account-action sign-in" href={SIGN_IN_URL}>
                Sign in to keep them
              </a>
              <button type="button" class="account-action sign-out" hidden>
                Sign out
              </button>
            </>
          )
        }
      </div>
    </div>

    <main>
      <div class="panels">
        {
          days.map(({ date, sets }) => (
            <section
              class="day-panel"
              id={`day-${date}`}
              role="tabpanel"
              aria-labelledby={`tab-${date}`}
              data-date={date}
            >
              <ol class="sets">
                {sets.map((set) => {
                  const names = set.artists.map((artist) => artist.name).join(' b2b ');
                  return (
                    <li class="set" data-key={set.key} data-start={set.start} data-end={set.end} hidden>
                      <span class="time">
                        <time class="start" datetime={set.start}>
                          {clockTime(set.start)}
                        </time>
                        <time class="end" datetime={set.end}>
                          {clockTime(set.end)}
                        </time>
                      </span>
                      <span class:list={['details', { single: set.artists.length === 1 }]}>
                        <span class="photo">
                          {set.image ? (
                            <img
                              src={set.image}
                              alt=""
                              loading="lazy"
                              decoding="async"
                              data-initials={initials(set.artists[0].name)}
                            />
                          ) : (
                            <span aria-hidden="true">{initials(set.artists[0].name)}</span>
                          )}
                        </span>
                        <span class="text">
                          <span class="artists">
                            {set.artists.map((artist, index) => (
                              <>
                                {index > 0 && <span class="b2b"> b2b </span>}
                                <a href={artistUrl(artist.id)}>{artist.name}</a>
                              </>
                            ))}
                          </span>
                          <span class="stage">{set.stageName}</span>
                        </span>
                      </span>
                      <FavouriteButton setKey={set.key} subject={names} />
                    </li>
                  );
                })}
              </ol>

              <p class="empty" hidden>
                No favourite sets on this day. Tap the heart on a set in the <a href={LINEUP_URL}>line-up</a> to save
                it.
              </p>
            </section>
          ))
        }
      </div>

      <noscript>
        <p class="empty">Turn on JavaScript to see your favourite sets.</p>
      </noscript>

      <template id="overlap-note">
        <li class="overlap">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 4l9 16H3z M12 10v4M12 17.5v.5"></path>
          </svg>
          <span></span>
        </li>
      </template>
    </main>
  </div>
</Base>

<script>
  import { ACCOUNT_AVAILABLE } from '../account/available.ts';
  import { sessionEmail } from '../account/session.ts';
  import { FAVOURITES_CHANGE_EVENT, readFavourites } from '../favourites/favourites.ts';
  import { festivalNow } from '../now/now-next.ts';
  import { FESTIVAL_TIME_ZONE } from '../site.ts';
  import { activeDayIndex, initialDate, overlapMinutes, setCountLabel } from '../timeline/timeline.ts';

  const dayButtons = [...document.querySelectorAll<HTMLButtonElement>('.days button')];
  const panels = document.querySelector<HTMLElement>('.panels')!;
  const dayPanels = [...panels.querySelectorAll<HTMLElement>('.day-panel')];
  const count = document.querySelector<HTMLElement>('.count')!;
  const overlapTemplate = document.querySelector<HTMLTemplateElement>('#overlap-note')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  function favouriteDates(favourites: Set<string>): Set<string> {
    return new Set([...favourites].map((key) => key.split('/')[0]));
  }

  const days = dayButtons.map((button) => ({ date: button.dataset.date!, end: button.dataset.end! }));
  let activeIndex = -1;

  function updateCount() {
    const day = days[activeIndex];
    count.textContent = day ? setCountLabel(Number(dayPanels[activeIndex].dataset.count ?? 0), day.date) : '';
  }

  function setActiveDay(index: number) {
    if (index === activeIndex || !days[index]) return;
    activeIndex = index;
    dayButtons.forEach((button, i) => button.setAttribute('aria-selected', String(i === index)));
    updateCount();
  }

  function render() {
    const favourites = readFavourites(localStorage);
    for (const panel of dayPanels) {
      for (const note of panel.querySelectorAll('.overlap')) note.remove();
      const shown = [...panel.querySelectorAll<HTMLLIElement>('.set')].filter((row) => {
        row.hidden = !favourites.has(row.dataset.key!);
        return !row.hidden;
      });
      shown.slice(1).forEach((row, index) => {
        const earlier = shown[index];
        const minutes = overlapMinutes(
          { start: earlier.dataset.start!, end: earlier.dataset.end! },
          { start: row.dataset.start!, end: row.dataset.end! },
        );
        if (minutes === 0) return;
        const note = overlapTemplate.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
        note.querySelector('span')!.textContent = `These two sets overlap by ${minutes} min`;
        row.before(note);
      });
      panel.dataset.count = String(shown.length);
      panel.querySelector<HTMLElement>('.empty')!.hidden = shown.length > 0;
    }
    updateCount();
  }

  dayButtons.forEach((button, index) => {
    button.addEventListener('click', () => {
      panels.scrollTo({
        left: index * panels.clientWidth,
        behavior: reducedMotion.matches ? 'instant' : 'smooth',
      });
    });
  });

  panels.addEventListener(
    'scroll',
    () => setActiveDay(activeDayIndex(panels.scrollLeft, panels.clientWidth, days.length)),
    { passive: true },
  );

  const deviceNote = document.querySelector<HTMLElement>('.device-note p')!;
  const signInLink = document.querySelector<HTMLElement>('.device-note .sign-in');
  const signOutButton = document.querySelector<HTMLButtonElement>('.device-note .sign-out');

  function renderAccount() {
    const email = ACCOUNT_AVAILABLE ? sessionEmail(localStorage) : null;
    deviceNote.textContent = email ? `Saved to your account ${email}.` : 'Saved on this device only.';
    if (signInLink) signInLink.hidden = email !== null;
    if (signOutButton) signOutButton.hidden = email === null;
  }

  signOutButton?.addEventListener('click', async () => {
    signOutButton.disabled = true;
    try {
      const { signOut } = await import('../account/supabase.ts');
      await signOut();
    } finally {
      signOutButton.disabled = false;
      renderAccount();
    }
  });

  // A change in an other tab, and a page from the back-forward cache, show the current favourites and account.
  document.addEventListener(FAVOURITES_CHANGE_EVENT, render);
  for (const type of ['storage', 'pageshow']) {
    addEventListener(type, () => {
      render();
      renderAccount();
    });
  }
  render();
  if (days.length > 0) {
    const startDate = initialDate(
      days,
      festivalNow(new Date(), FESTIVAL_TIME_ZONE),
      favouriteDates(readFavourites(localStorage)),
    );
    const startIndex = Math.max(
      0,
      days.findIndex((day) => day.date === startDate),
    );
    panels.scrollTo({ left: startIndex * panels.clientWidth, behavior: 'instant' });
    setActiveDay(startIndex);
  }
  renderAccount();

  // With no network, a photo that the service worker did not save cannot load.
  function showInitials(image: HTMLImageElement) {
    const span = document.createElement('span');
    span.setAttribute('aria-hidden', 'true');
    span.textContent = image.dataset.initials ?? '';
    image.replaceWith(span);
  }
  for (const image of document.querySelectorAll<HTMLImageElement>('.photo img')) {
    if (image.complete && image.naturalWidth === 0) showInitials(image);
    else image.addEventListener('error', () => showInitials(image));
  }
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: calc(100dvh - var(--main-nav-height));
    padding-top: 1.75rem;
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1.25rem;
  }

  .days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .days button {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    background: var(--color-control);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  .weekday {
    font-weight: 700;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .days button[aria-selected='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
  }

  .days button[aria-selected='true'] .date {
    color: inherit;
    font-weight: 700;
  }

  .device-note {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--color-control);
  }

  .device-note p {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .account-action {
    display: flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    border-top: 1px solid var(--color-divider);
  }

  .panels {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .day-panel {
    flex: 0 0 100%;
    width: 100%;
    overflow-y: auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [hidden] {
    display: none !important;
  }

  .set {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .time {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.125rem;
    width: 2.875rem;
    font-variant-numeric: tabular-nums;
  }

  .start {
    color: var(--color-accent);
    font-weight: 700;
  }

  .end {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .details {
    position: relative;
    display: flex;
    flex: 1;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    min-height: 3rem;
  }

  .photo {
    display: grid;
    flex: none;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--color-card);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
  }

  .artists {
    font-weight: 700;
    line-height: 1.25;
  }

  .artists a {
    text-decoration: none;
  }

  .artists a:hover,
  .artists a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  /* A set with one artist is a link from the photo to the stage name. A B2B set has one link for each artist. */
  .single .artists a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .b2b {
    font-weight: 400;
  }

  .stage {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .overlap {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-warning-background);
    color: var(--color-warning);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .overlap svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .empty {
    margin: 0;
    padding: 1rem 1.25rem;
    color: var(--color-text-muted);
  }
</style>

---
import PageHeader from '../components/PageHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadLineup } from '../data/load.ts';
import Base from '../layouts/Base.astro';
import { initials } from '../now/now-next.ts';
import { SITE_NAME } from '../site.ts';
import { timelineDays } from '../timeline/timeline.ts';
import { playableSetArtist } from '../artist/music-player.ts';
import { dayLabelParts } from '../timetable/layout.ts';
import { ACCOUNT_AVAILABLE } from '../account/available.ts';
import { LINEUP_URL, SIGN_IN_URL, artistUrl } from '../urls.ts';

const lineup = await loadLineup();
const days = timelineDays(lineup);
const clockTime = (localTime: string) => localTime.slice(11, 16);
---

<Base title={`My timeline · ${SITE_NAME}`} mainPage="timeline" footer={false}>
  <div class="page">
    <div class="top">
      <PageHeader lineup={lineup} title="My timeline">
        <span slot="eyebrow" class="count" aria-live="polite"></span>
      </PageHeader>

      {
        days.length > 0 && (
          <div class="days" role="group" aria-label="Festival days">
            {days.map(({ date, end }) => {
              const { weekday, dayAndMonth } = dayLabelParts(date);
              return (
                <button type="button" data-date={date} data-end={end} aria-pressed="false">
                  <span class="weekday">{weekday}</span>
                  <span class="date">{dayAndMonth}</span>
                </button>
              );
            })}
          </div>
        )
      }
    </div>
    <noscript>
      <p class="empty">Turn on JavaScript to see your favourite sets.</p>
    </noscript>

    <main>
      {
        days.map(({ date, sets }) => (
          <ol class="sets" data-date={date}>
            {sets.map((set) => {
              const playable = playableSetArtist(set.artists);
              return (
                <li class="set" data-key={set.key} data-start={set.start} data-end={set.end} hidden>
                  <span class="time">
                    <time class="start" datetime={set.start}>
                      {clockTime(set.start)}
                    </time>
                    <time class="end" datetime={set.end}>
                      {clockTime(set.end)}
                    </time>
                  </span>
                  <span class:list={['details', { single: set.artists.length === 1 }]}>
                    <span class="photo">
                      {set.image ? (
                        <img
                          src={set.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          data-initials={initials(set.artists[0].name)}
                        />
                      ) : (
                        <span aria-hidden="true">{initials(set.artists[0].name)}</span>
                      )}
                    </span>
                    <span class="text">
                      <span class="artists">
                        {set.artists.map((artist, index) => (
                          <>
                            {index > 0 && <span class="b2b"> b2b </span>}
                            <a href={artistUrl(artist.id)}>{artist.name}</a>
                          </>
                        ))}
                      </span>
                      <span class="stage">{set.stageName}</span>
                    </span>
                  </span>
                  {playable && (
                    <button
                      type="button"
                      class="play"
                      aria-pressed="false"
                      aria-label={`Play a preview of ${playable.artist.name}`}
                      data-artist-id={playable.artist.id}
                      data-artist={playable.artist.name}
                      data-artist-url={artistUrl(playable.artist.id)}
                      data-players={JSON.stringify(playable.players)}
                    >
                      <svg class="icon-play" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                        <path d="M8 5v14l11-7z"></path>
                      </svg>
                      <svg class="icon-stop" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                        <path d="M7 6h4v12H7zM13 6h4v12h-4z"></path>
                      </svg>
                    </button>
                  )}
                </li>
              );
            })}
            <li class="empty" hidden>
              No favourite sets on this day. Tap the heart on a set in the <a href={LINEUP_URL}>line-up</a> to save it.
            </li>
            <li>
              <SiteFooter />
            </li>
          </ol>
        ))
      }

      <template id="overlap-note">
        <li class="overlap">
          <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 4l9 16H3z M12 10v4M12 17.5v.5"></path>
          </svg>
          <span></span>
        </li>
      </template>
    </main>

    <div class="device-note">
      <p>Saved on this device only.</p>
      {
        ACCOUNT_AVAILABLE && (
          <>
            <a class="account-action sign-in" href={SIGN_IN_URL}>
              Sign in to keep them
            </a>
            <button type="button" class="account-action sign-out" hidden>
              Sign out
            </button>
          </>
        )
      }
    </div>
  </div>
</Base>

<script>
  import { ACCOUNT_AVAILABLE } from '../account/available.ts';
  import type { PreviewPlayer } from '../artist/music-player.ts';
  import { sessionEmail } from '../account/session.ts';
  import { FAVOURITES_CHANGE_EVENT, readFavourites } from '../favourites/favourites.ts';
  import { festivalNow } from '../now/now-next.ts';
  import { PLAYER_CHANGE_EVENT, isTrackPlaying, toggleTrack } from '../player/global-player.ts';
  import { onPageMount } from '../player/navigation.ts';
  import { FESTIVAL_TIME_ZONE } from '../site.ts';
  import { readPickedDay, savePickedDay } from '../picked-day.ts';
  import { initialDate, overlapMinutes, setCountLabel } from '../timeline/timeline.ts';

  onPageMount((signal) => {
    const overlapTemplate = document.querySelector<HTMLTemplateElement>('#overlap-note');
    if (!overlapTemplate) return;

    const dayButtons = [...document.querySelectorAll<HTMLButtonElement>('.days button')];
    const main = document.querySelector('main')!;
    const lists = [...main.querySelectorAll<HTMLOListElement>('.sets')];
    const count = document.querySelector<HTMLElement>('.count')!;

    function favouriteDates(favourites: Set<string>): Set<string> {
      return new Set([...favourites].map((key) => key.split('/')[0]));
    }

    const days = dayButtons.map((button) => ({ date: button.dataset.date!, end: button.dataset.end! }));
    const now = festivalNow(new Date(), FESTIVAL_TIME_ZONE);
    const pickedDate = readPickedDay(
      sessionStorage,
      'timeline',
      days.map(({ date }) => date),
    )?.date;
    const startDate =
      days.length > 0 ? (pickedDate ?? initialDate(days, now, favouriteDates(readFavourites(localStorage)))) : '';
    let selectedIndex = days.findIndex(({ date }) => date === startDate);
    main.scrollLeft = selectedIndex * main.clientWidth;

    function render() {
      const favourites = readFavourites(localStorage);
      for (const list of lists) {
        for (const note of list.querySelectorAll('.overlap')) note.remove();
        const shown = [...list.querySelectorAll<HTMLLIElement>('.set')].filter((row) => {
          row.hidden = !favourites.has(row.dataset.key!);
          return !row.hidden;
        });

        shown.slice(1).forEach((row, index) => {
          const earlier = shown[index];
          const minutes = overlapMinutes(
            { start: earlier.dataset.start!, end: earlier.dataset.end! },
            { start: row.dataset.start!, end: row.dataset.end! },
          );
          if (minutes === 0) return;
          const note = overlapTemplate!.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
          note.querySelector('span')!.textContent = `These two sets overlap by ${minutes} min`;
          row.before(note);
        });
        list.querySelector<HTMLElement>('.empty')!.hidden = shown.length > 0;
      }
      showSelectedDay();
    }

    function showSelectedDay() {
      dayButtons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === selectedIndex)));
      const list = lists[selectedIndex];
      const shown = list?.querySelectorAll('.set:not([hidden])').length ?? 0;
      count.textContent = list ? setCountLabel(shown, list.dataset.date!) : '';
    }

    dayButtons.forEach((button, index) => {
      button.addEventListener('click', () => main.scrollTo({ left: index * main.clientWidth, behavior: 'smooth' }), {
        signal,
      });
    });

    // A swipe and a tap on a day scroll the lists. The list in view is the selected day.
    main.addEventListener(
      'scroll',
      () => {
        const index = Math.round(main.scrollLeft / main.clientWidth);
        if (index === selectedIndex) return;
        selectedIndex = index;
        showSelectedDay();
        savePickedDay(sessionStorage, 'timeline', { date: days[selectedIndex].date });
      },
      { signal },
    );

    const playButtons = [...main.querySelectorAll<HTMLButtonElement>('.play')];
    function renderPlayButtons() {
      for (const button of playButtons) {
        const playing = isTrackPlaying(button.dataset.artistId!);
        button.setAttribute('aria-pressed', String(playing));
        button.setAttribute(
          'aria-label',
          playing ? `Stop the preview of ${button.dataset.artist}` : `Play a preview of ${button.dataset.artist}`,
        );
      }
    }
    function trackFromButton(button: HTMLButtonElement) {
      const players: PreviewPlayer[] = JSON.parse(button.dataset.players ?? '[]');
      return {
        artistId: button.dataset.artistId!,
        artistName: button.dataset.artist!,
        artistUrl: button.dataset.artistUrl!,
        players,
      };
    }
    // The previous and next buttons of the player go through the favourite sets of all days, in timeline order.
    for (const button of playButtons) {
      button.addEventListener(
        'click',
        () => {
          const favouriteQueue = playButtons
            .filter((candidate) => !candidate.closest<HTMLLIElement>('.set')?.hidden)
            .map(trackFromButton);
          toggleTrack(trackFromButton(button), favouriteQueue);
        },
        { signal },
      );
    }
    document.addEventListener(PLAYER_CHANGE_EVENT, renderPlayButtons, { signal });
    renderPlayButtons();

    const deviceNote = document.querySelector<HTMLElement>('.device-note p')!;
    const signInLink = document.querySelector<HTMLElement>('.device-note .sign-in');
    const signOutButton = document.querySelector<HTMLButtonElement>('.device-note .sign-out');

    function renderAccount() {
      const email = ACCOUNT_AVAILABLE ? sessionEmail(localStorage) : null;
      deviceNote.textContent = email ? `Saved to your account ${email}.` : 'Saved on this device only.';
      if (signInLink) signInLink.hidden = email !== null;
      if (signOutButton) signOutButton.hidden = email === null;
    }

    signOutButton?.addEventListener(
      'click',
      async () => {
        signOutButton.disabled = true;
        try {
          const { signOut } = await import('../account/supabase.ts');
          await signOut();
        } finally {
          if (!signal.aborted) {
            signOutButton.disabled = false;
            renderAccount();
          }
        }
      },
      { signal },
    );

    // A change in another tab, and a page from the back-forward cache, show the current favourites and account.
    document.addEventListener(FAVOURITES_CHANGE_EVENT, render, { signal });
    for (const type of ['storage', 'pageshow']) {
      addEventListener(
        type,
        () => {
          render();
          renderAccount();
        },
        { signal },
      );
    }
    render();
    renderAccount();

    // With no network, a photo that the service worker did not save cannot load.
    function showInitials(image: HTMLImageElement) {
      const span = document.createElement('span');
      span.setAttribute('aria-hidden', 'true');
      span.textContent = image.dataset.initials ?? '';
      image.replaceWith(span);
    }
    for (const image of document.querySelectorAll<HTMLImageElement>('.photo img')) {
      if (image.complete && image.naturalWidth === 0) showInitials(image);
      else image.addEventListener('error', () => showInitials(image), { signal });
    }
  });
</script>

<style>
  .page {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: calc(100dvh - var(--bottom-chrome-height));
    padding-top: 1.75rem;
  }

  .top {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1.25rem;
  }

  .days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.5rem;
  }

  .days button {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    background: var(--color-control);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }

  .weekday {
    font-weight: 700;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .days button[aria-pressed='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
  }

  .days button[aria-pressed='true'] .date {
    color: inherit;
    font-weight: 700;
  }

  /* The note floats above the bottom of the list. The sets show around it. */
  .device-note {
    position: absolute;
    right: 1.25rem;
    bottom: 0.75rem;
    left: 1.25rem;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0.875rem;
    border-radius: 0.5rem;
    /* The page colour under the control colour makes the note opaque. */
    background: linear-gradient(var(--color-control), var(--color-control)), var(--color-background);
  }

  .device-note p {
    flex: 1;
    min-width: 0;
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    overflow-wrap: anywhere;
  }

  .account-action {
    display: flex;
    flex: none;
    align-items: center;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-accent);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
  }

  /* Each day is a list in a row. A horizontal swipe snaps to the next or the previous day. */
  main {
    display: flex;
    flex: 1;
    min-height: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    border-top: 1px solid var(--color-divider);
  }

  /*
   * Each list ends with the footer.
   * The position keeps the hidden text of the footer in the list, so the page is not wider than the screen.
   */
  .sets {
    position: relative;
    flex: none;
    width: 100%;
    overflow-y: auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* The end of the list can scroll above the note. */
    padding-bottom: 4.5rem;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  [hidden] {
    display: none !important;
  }

  .set {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    min-height: 4.25rem;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--color-divider);
  }

  .time {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 0.125rem;
    width: 2.875rem;
    font-variant-numeric: tabular-nums;
  }

  .start {
    color: var(--color-accent);
    font-weight: 700;
  }

  .end {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .details {
    position: relative;
    display: flex;
    flex: 1;
    gap: 0.75rem;
    align-items: center;
    min-width: 0;
    min-height: 3rem;
  }

  .photo {
    display: grid;
    flex: none;
    width: 3rem;
    height: 3rem;
    overflow: hidden;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--color-card);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 0.1875rem;
    min-width: 0;
  }

  .artists {
    font-weight: 700;
    line-height: 1.25;
  }

  .artists a {
    text-decoration: none;
  }

  .artists a:hover,
  .artists a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  /* A set with one artist is a link from the photo to the stage name. A B2B set has one link for each artist. */
  .single .artists a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .b2b {
    font-weight: 400;
  }

  .stage {
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  /* The round play button at the end of a row, as in the Explore design. */
  .play {
    position: relative;
    display: grid;
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    place-items: center;
    border: 1px solid var(--color-text);
    border-radius: 50%;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  /* The visible circle is small, so a larger invisible area receives the touch. */
  .play::before {
    position: absolute;
    inset: -0.625rem;
    content: '';
  }

  .play svg {
    fill: currentColor;
  }

  .play[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-background);
  }

  .play[aria-pressed='false'] .icon-stop,
  .play[aria-pressed='true'] .icon-play {
    display: none;
  }

  .overlap {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--color-divider);
    background: var(--color-warning-background);
    color: var(--color-warning);
    font-size: 0.8125rem;
    font-weight: 700;
  }

  .overlap svg {
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .empty {
    margin: 0;
    padding: 1rem 1.25rem;
    color: var(--color-text-muted);
  }
</style>

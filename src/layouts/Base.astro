---
import { Font } from 'astro:assets';
import FavouriteHint from '../components/FavouriteHint.astro';
import MainNav, { type MainPage } from '../components/MainNav.astro';
import '../styles/theme.css';

interface Props {
  title: string;
  /** The link of this main page in the bottom bar shows in the accent color. */
  mainPage?: MainPage;
}

const { title, mainPage } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-body" preload />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <FavouriteHint />
    <MainNav current={mainPage} />
  </body>
</html>

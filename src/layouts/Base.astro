---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import FavouriteHint from '../components/FavouriteHint.astro';
import GlobalPlayer from '../components/GlobalPlayer.astro';
import MainNav, { type MainPage } from '../components/MainNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { BACKGROUND_COLOR } from '../site';
import '../styles/theme.css';

interface Props {
  title: string;
  /** The link of this main page in the bottom bar shows in the accent color. */
  mainPage?: MainPage;
  /** A page with no bottom bar and no message about favourites, for example the sign-in page. */
  bare?: boolean;
  /** Render the footer at the bottom of the page. Set false when a page places SiteFooter inside its own scroll container. */
  footer?: boolean;
}

const { title, mainPage, bare = false, footer = true } = Astro.props;
---

<html lang="en" transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content={BACKGROUND_COLOR} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-body" preload />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class:list={{ bare }}>
    <div id="page-shell">
      <slot />
      {
        !bare && (
          <>
            {footer && <SiteFooter />}
            <FavouriteHint />
            <MainNav current={mainPage} />
          </>
        )
      }
    </div>
    <GlobalPlayer />
    <script>
      import { swapFunctions } from 'astro:transitions/client';
      import { recordNavigationFrom } from '../player/navigation.ts';
      import { SAVE_PHOTOS_MESSAGE, SERVICE_WORKER_URL } from '../urls';

      // Swap only #page-shell and keep <body> + #global-player untouched so an active music iframe never reloads.
      document.addEventListener('astro:before-swap', (event) => {
        recordNavigationFrom(event.from);
        window.__astroSoftNav = true;

        event.swap = () => {
          const doc = event.newDocument;
          const dockHeight = document.documentElement.style.getPropertyValue('--player-dock-height');
          swapFunctions.deselectScripts(doc);
          swapFunctions.swapRootAttributes(doc);
          if (dockHeight) document.documentElement.style.setProperty('--player-dock-height', dockHeight);
          swapFunctions.swapHeadElements(doc);
          const restoreFocus = swapFunctions.saveFocus();

          for (const { name } of [...document.body.attributes]) {
            if (!doc.body.hasAttribute(name)) document.body.removeAttribute(name);
          }
          for (const { name, value } of [...doc.body.attributes]) {
            document.body.setAttribute(name, value);
          }

          for (const announcer of document.body.querySelectorAll(':scope > .astro-route-announcer')) {
            announcer.remove();
          }

          const oldShell = document.getElementById('page-shell');
          const newShell = doc.getElementById('page-shell');
          if (oldShell && newShell) {
            oldShell.replaceWith(newShell);
            // Astro emits page-level <script> tags outside <Base> as direct children of <body>.
            // Move any not-yet-executed ones into #page-shell so Astro's router runs them.
            for (const script of [...doc.body.querySelectorAll<HTMLScriptElement>(':scope > script')]) {
              if (script.dataset.astroExec === undefined) newShell.append(script);
            }
          } else {
            swapFunctions.swapBodyElement(doc.body, document.body);
          }

          restoreFocus();
        };
      });

      // The service worker starts after the page loads, so the page gets the network first.
      // After that, the service worker saves the artist photos. See src/pwa/sw.js.
      async function startServiceWorker() {
        await navigator.serviceWorker.register(SERVICE_WORKER_URL);
        const registration = await navigator.serviceWorker.ready;
        registration.active?.postMessage(SAVE_PHOTOS_MESSAGE);
      }

      // The dev server does not make the service worker. Only the build makes it.
      if (import.meta.env.PROD && 'serviceWorker' in navigator) {
        if (document.readyState === 'complete') void startServiceWorker();
        else addEventListener('load', () => void startServiceWorker());
      }
    </script>
  </body>
</html>

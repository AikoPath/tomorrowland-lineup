---
// The site uses the Tomorrowland name and logo, so the footer tells users that Tomorrowland did not make it.
---

<footer class="site-footer">
  <p>Unofficial fan site. Not affiliated with Tomorrowland.</p>
  <p>
    Made with <span class="heart" aria-hidden="true">♥</span><span class="sr-only">love</span> in Singapore
  </p>
</footer>

<style>
  .site-footer {
    padding: 2rem 1rem 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    text-align: center;
  }

  p {
    margin: 0;
  }

  .heart {
    color: var(--color-accent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

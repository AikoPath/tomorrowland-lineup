---
import type { MusicTab, PreviewPlayer } from '../artist/music-player.ts';
import PlatformIcon from './PlatformIcon.astro';

interface Props {
  artistId: string;
  artistName: string;
  artistUrl: string;
  tabs: MusicTab[];
}

const { artistId, artistName, artistUrl, tabs } = Astro.props;
const players: PreviewPlayer[] = tabs.flatMap((tab) => (tab.player ? [{ service: tab.key, player: tab.player }] : []));
const trackData = JSON.stringify({ artistId, artistName, artistUrl, players });
---

<section class="listen" data-music-player data-track={trackData}>
  <h2>Listen</h2>
  <ul class="pills">
    {
      tabs.map((tab, index) => (
        <li>
          {tab.player ? (
            <button
              type="button"
              class="pill"
              data-service={tab.key}
              data-primary={index === 0 ? 'true' : 'false'}
              aria-pressed="false"
              aria-label={`Play ${artistName} on ${tab.label}`}
            >
              <PlatformIcon platform={tab.key} />
              <span>{tab.label}</span>
              <svg class="state icon-play" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <path d="M8 5v14l11-7z"></path>
              </svg>
              <svg class="state icon-stop" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <path d="M7 6h4v12H7zM13 6h4v12h-4z"></path>
              </svg>
            </button>
          ) : (
            <a href={tab.url} class="pill" rel="noopener" target="_blank">
              <PlatformIcon platform={tab.key} />
              <span>{tab.label}</span>
            </a>
          )}
        </li>
      ))
    }
  </ul>
</section>

<script>
  import { musicLabels, type MusicKey } from '../artist/artist-page.ts';
  import {
    PLAYER_CHANGE_EVENT,
    getPreferredService,
    isTrackPlaying,
    playTrack,
    stopPlayback,
  } from '../player/global-player.ts';
  import { onPageMount } from '../player/navigation.ts';
  import type { PlayerTrack } from '../player/player-state.ts';

  onPageMount((signal) => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-music-player]')) {
      const track: PlayerTrack = JSON.parse(root.dataset.track ?? '{}');
      const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-service]')];
      if (buttons.length === 0) continue;

      const available = buttons.map((button) => button.dataset.service as MusicKey);

      function render() {
        const playingArtist = isTrackPlaying(track.artistId);
        const preferred = getPreferredService();
        const primaryService = preferred && available.includes(preferred) ? preferred : available[0];

        for (const button of buttons) {
          const service = button.dataset.service as MusicKey;
          const label = musicLabels[service];
          const active = isTrackPlaying(track.artistId, service);
          button.setAttribute('aria-pressed', String(active));
          button.dataset.primary = String(!playingArtist && service === primaryService);
          button.setAttribute(
            'aria-label',
            active ? `Stop ${track.artistName} on ${label}` : `Play ${track.artistName} on ${label}`,
          );
        }
      }

      for (const button of buttons) {
        button.addEventListener(
          'click',
          () => {
            const service = button.dataset.service as MusicKey;
            if (isTrackPlaying(track.artistId, service)) {
              stopPlayback();
            } else {
              playTrack(track, { service, persistService: true });
            }
          },
          { signal },
        );
      }

      document.addEventListener(PLAYER_CHANGE_EVENT, render, { signal });
      render();
    }
  });
</script>

<style>
  .listen {
    display: grid;
    gap: 0.625rem;
  }

  h2 {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.125rem;
    text-transform: uppercase;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pill {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-control-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    text-decoration: none;
    cursor: pointer;
  }

  .pill :global(svg:first-child) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .pill:hover,
  .pill:focus-visible {
    border-color: var(--color-control-line-strong);
  }

  .pill[data-primary='true'] {
    border-color: transparent;
    background: var(--gradient-accent);
    font-weight: 700;
  }

  .pill[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-background);
    font-weight: 700;
  }

  .state {
    flex: none;
    fill: currentColor;
  }

  .pill[aria-pressed='false'] .icon-stop,
  .pill[aria-pressed='true'] .icon-play {
    display: none;
  }
</style>

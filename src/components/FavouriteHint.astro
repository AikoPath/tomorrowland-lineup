---
// Each page has this message above the bottom bar. The script also controls all heart buttons on the page.
import { ACCOUNT_AVAILABLE } from '../account/available.ts';
import { SIGN_IN_URL } from '../urls.ts';
---

<div class="favourite-hint" role="status">
  <div class="content" hidden>
    {
      ACCOUNT_AVAILABLE ? (
        <p>
          Favourite saved on this device only. <a href={SIGN_IN_URL}>Sign in</a> to keep your favourites on all your
          devices.
        </p>
      ) : (
        <p>Favourite saved on this device only.</p>
      )
    }
    <button type="button" class="dismiss" aria-label="Dismiss">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <div class="content sync-failed" hidden>
    <p>Your account did not get your last changes. The site will try again.</p>
  </div>
</div>

<script>
  import { ACCOUNT_AVAILABLE } from '../account/available.ts';
  import { hasSession } from '../account/session.ts';
  import {
    FAVOURITES_CHANGE_EVENT,
    dismissHint,
    isFavourite,
    isHintShown,
    readFavourites,
    toggleFavourite,
  } from '../favourites/favourites.ts';
  import { addPending, syncFavourites } from '../favourites/sync.ts';

  const hint = document.querySelector<HTMLElement>('.favourite-hint .content')!;
  const syncFailed = document.querySelector<HTMLElement>('.favourite-hint .sync-failed')!;
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-favourite-key]')];

  function setKeys(button: HTMLButtonElement): string[] {
    return button.dataset.favouriteKey!.split(' ');
  }

  function render() {
    const favourites = readFavourites(localStorage);
    for (const button of buttons) {
      const on = isFavourite(favourites, setKeys(button));
      const subject = button.dataset.favouriteSubject!;
      button.setAttribute('aria-pressed', String(on));
      button.setAttribute('aria-label', on ? `Remove ${subject} from favourites` : `Add ${subject} to favourites`);
    }
    hint.hidden = signedIn() || !isHintShown(localStorage);
  }

  function signedIn(): boolean {
    return ACCOUNT_AVAILABLE && hasSession(localStorage);
  }

  // One sync at a time. The page loads the Supabase client only for a user who is signed in.
  let syncs = Promise.resolve();
  function sync() {
    if (!signedIn()) return;
    syncs = syncs
      .then(async () => {
        const { favouriteAccount } = await import('../account/supabase.ts');
        await syncFavourites(localStorage, favouriteAccount);
        syncFailed.hidden = true;
        render();
        document.dispatchEvent(new Event(FAVOURITES_CHANGE_EVENT));
      })
      // The changes stay pending until the next sync.
      .catch(() => {
        syncFailed.hidden = false;
      });
  }

  for (const button of buttons) {
    button.addEventListener('click', () => {
      const keys = setKeys(button);
      const favourites = toggleFavourite(localStorage, keys);
      if (signedIn()) addPending(localStorage, keys.map((key) => ({ key, favourite: favourites.has(key) })));
      render();
      document.dispatchEvent(new Event(FAVOURITES_CHANGE_EVENT));
      sync();
    });
  }

  hint.querySelector('.dismiss')!.addEventListener('click', () => {
    dismissHint(localStorage);
    render();
  });

  // A change in an other tab, and a page from the back-forward cache, show the current favourites.
  // The pageshow event also comes after the first load of the page, so each page gets the favourites of the account.
  addEventListener('storage', render);
  addEventListener('pageshow', () => {
    render();
    sync();
  });
  addEventListener('online', sync);
  render();
</script>

<style>
  .favourite-hint {
    position: fixed;
    right: 0;
    bottom: var(--main-nav-height);
    left: 0;
    z-index: 10;
  }

  .content {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    padding: 0.25rem 0.25rem 0.25rem 1rem;
    border-top: 1px solid var(--color-control-line);
    background: var(--color-card);
  }

  .sync-failed {
    padding-right: 1rem;
  }

  .content[hidden] {
    display: none;
  }

  p {
    flex: 1;
    margin: 0;
    padding: 0.5rem 0;
    font-size: 0.8125rem;
  }

  p a {
    font-weight: 700;
    color: var(--color-accent);
  }

  .dismiss {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
</style>

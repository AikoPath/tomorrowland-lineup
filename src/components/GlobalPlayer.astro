---
import { musicLabels, type MusicKey } from '../artist/artist-page.ts';
import PlatformIcon from './PlatformIcon.astro';

const musicServices = Object.entries(musicLabels) as [MusicKey, string][];
---

<aside
  id="global-player"
  class="global-player"
  aria-label="Music player"
  hidden
  data-astro-transition-persist="global-player"
>
  <div class="inner">
    <div class="header">
      <a class="artist" data-player-artist href="">
        <span class="indicator" aria-hidden="true"></span>
        <span class="artist-name" data-player-artist-name></span>
      </a>
      <div class="controls">
        <div class="step-controls" role="group" aria-label="Switch artist">
          <button
            type="button"
            class="icon-btn"
            data-player-prev
            aria-label="Previous artist"
            title="Previous artist"
            disabled
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M15 6l-6 6 6 6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="icon-btn"
            data-player-next
            aria-label="Next artist"
            title="Next artist"
            disabled
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
              <path d="M9 6l6 6-6 6"></path>
            </svg>
          </button>
        </div>
        <div class="services" role="group" aria-label="Music service">
          {
            musicServices.map(([key, label]) => (
              <button
                type="button"
                class="service-btn"
                data-player-service={key}
                aria-label={`Play on ${label}`}
                aria-pressed="false"
                title={label}
                hidden
              >
                <PlatformIcon platform={key} />
              </button>
            ))
          }
        </div>
        <button
          type="button"
          class="icon-btn toggle"
          data-player-toggle
          aria-expanded="true"
          aria-label="Minimize player"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M6 9l6 6 6-6"></path>
          </svg>
        </button>
        <button type="button" class="icon-btn" data-player-close aria-label="Stop and close player">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>
    </div>

    <div class="body" data-player-body>
      <p class="fallback" data-player-fallback hidden></p>
      <p class="status" data-player-status role="status" hidden></p>
      <div class="slot" data-player-slot></div>
    </div>
  </div>
</aside>

<script>
  import { mountGlobalPlayer } from '../player/global-player.ts';

  const root = document.getElementById('global-player');
  if (root) mountGlobalPlayer(root);
</script>

<style>
  .global-player {
    position: fixed;
    right: 0;
    bottom: var(--main-nav-height);
    left: 0;
    z-index: 15;
    border-top: 1px solid var(--color-control-line);
    background: var(--color-bar);
    box-shadow: var(--shadow-dock);
  }

  :global(body.bare) .global-player {
    padding-bottom: env(safe-area-inset-bottom);
  }

  .global-player[hidden] {
    display: none;
  }

  .inner {
    max-width: 52rem;
    margin: 0 auto;
  }

  .header {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.625rem;
    padding: 0.125rem 0.375rem 0.125rem 0.875rem;
  }

  .artist {
    display: flex;
    flex: 1;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
    min-height: 2.25rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
  }

  .artist:hover .artist-name,
  .artist:focus-visible .artist-name {
    color: var(--color-accent);
  }

  .indicator {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .artist-name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .controls {
    display: flex;
    flex: none;
    gap: 0.125rem;
    align-items: center;
  }

  .services,
  .step-controls {
    display: flex;
    gap: 0.125rem;
    align-items: center;
  }

  .services {
    margin-right: 0.125rem;
  }

  /* When minimized, hide service icons so the artist name and < > controls have plenty of space. */
  .global-player[data-minimized='true'] .services {
    display: none;
  }

  .service-btn,
  .icon-btn {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 0.5rem;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .icon-btn:disabled {
    opacity: 0.3;
    cursor: default;
  }

  @media (max-width: 30rem) {
    .global-player[data-minimized='false'] .service-btn {
      width: 1.875rem;
      height: 2rem;
    }

    .global-player[data-minimized='false'] .icon-btn {
      width: 2rem;
      height: 2rem;
    }
  }

  .service-btn[hidden] {
    display: none;
  }

  .service-btn :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .service-btn:hover,
  .icon-btn:hover {
    color: var(--color-text);
  }

  .service-btn[aria-pressed='true'] {
    background: var(--color-control);
    color: var(--color-accent);
  }

  .icon-btn svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .toggle svg {
    transition: transform 150ms;
  }

  .global-player[data-minimized='true'] .toggle svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .toggle svg {
      transition: none;
    }
  }

  .body {
    padding: 0 0.5rem 0.5rem;
  }

  /* Collapse visually without display: none so the embedded iframe keeps playing while minimized. */
  .global-player[data-minimized='true'] .body {
    height: 0;
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }

  .fallback,
  .status {
    margin: 0 0 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .fallback[hidden],
  .status[hidden] {
    display: none;
  }

  .slot {
    min-height: 80px;
  }

  .slot :global(iframe) {
    display: block;
    width: 100%;
    height: 80px;
    border: 0;
    border-radius: 0.75rem;
  }

  .global-player[data-service='soundcloud'] .slot,
  .global-player[data-service='soundcloud'] .slot :global(iframe) {
    min-height: 116px;
    height: 116px;
  }

  .global-player[data-service='apple_music'] .slot,
  .global-player[data-service='apple_music'] .slot :global(iframe) {
    min-height: 150px;
    height: 150px;
  }

  .global-player[data-service='youtube'] .slot,
  .global-player[data-service='youtube'] .slot :global(iframe) {
    min-height: min(160px, 45vw);
    height: min(160px, 45vw);
  }

  /*
   * On the artist page, the YouTube player of the artist covers the video box of the page (see MusicPlayer.astro).
   * The iframe does not move in the DOM, because a moved iframe loads again and stops.
   * The dock is below the top bar and the navigation bar of the page, so that the video goes behind them when the page scrolls.
   */
  @supports (anchor-name: --artist-video) {
    .global-player[data-in-video-box='true'] {
      z-index: 1;
      border-top: 0;
    }

    /* The bar of the dock covers the video when the video scrolls behind it. */
    .global-player[data-in-video-box='true'] .header {
      position: relative;
      z-index: 1;
      border-top: 1px solid var(--color-control-line);
      background: var(--color-bar);
    }

    .global-player[data-in-video-box='true'] .body {
      padding-bottom: 0;
    }

    /* The Listen buttons of the page change the service, and the dock has no player to minimize. */
    .global-player[data-in-video-box='true'] .services,
    .global-player[data-in-video-box='true'] .toggle {
      display: none;
    }

    .global-player[data-in-video-box='true'] .slot {
      position: fixed;
      position-anchor: --artist-video;
      top: anchor(top);
      left: anchor(left);
      width: anchor-size(width);
      min-height: 0;
      height: anchor-size(height);
      /* The player shows also when the dock is minimized. */
      visibility: visible;
      pointer-events: auto;
    }

    .global-player[data-in-video-box='true'] .slot :global(iframe) {
      min-height: 0;
      height: 100%;
      border-radius: 0.5rem;
    }
  }
</style>

---
interface Props {
  name: string;
  label: string;
  /** The text of the first option. This option has an empty value and removes the filter. */
  anyLabel: string;
  options: { value: string; label: string }[];
}

const { name, label, anyLabel, options } = Astro.props;
---

<span class="dropdown">
  <select name={name} aria-label={label}>
    {/* Browsers without a customizable select ignore this button and show the selected option. */}
    <button type="button"><selectedcontent></selectedcontent></button>
    <option value="">{anyLabel}</option>
    {options.map((option) => <option value={option.value}>{option.label}</option>)}
  </select>
</span>

<style>
  .dropdown {
    position: relative;
    display: block;
    min-width: 0;
  }

  /* The chevron is on the wrapper, because a select element cannot have ::after content. */
  .dropdown::after {
    position: absolute;
    top: 50%;
    right: 0.875rem;
    width: 1rem;
    height: 1rem;
    background: var(--color-text-muted);
    content: '';
    mask: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>')
      center / contain no-repeat;
    pointer-events: none;
    transition: rotate 150ms;
    translate: 0 -50%;
  }

  select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 2.5rem 0 0.875rem;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    appearance: none;
    background: var(--color-control);
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    text-overflow: ellipsis;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 150ms;
  }

  select:hover {
    border-color: var(--color-control-line-strong);
  }

  /* A dropdown with a value other than the first option is an active filter. */
  select:not(:has(option[value='']:checked)) {
    border-color: var(--color-accent);
    font-weight: 700;
  }

  .dropdown:has(select:not(:has(option[value='']:checked)))::after {
    background: var(--color-accent);
  }

  /* Browsers with a customizable select also show the open list in the theme. Other browsers show their own list. */
  @supports (appearance: base-select) {
    select,
    ::picker(select) {
      appearance: base-select;
    }

    select {
      display: flex;
      align-items: center;
    }

    select::picker-icon {
      display: none;
    }

    selectedcontent {
      display: block;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .dropdown:has(select:open)::after {
      rotate: 180deg;
    }

    ::picker(select) {
      max-height: min(20rem, 60dvh);
      margin-top: 0.375rem;
      padding: 0.25rem;
      border: 1px solid var(--color-control-line);
      border-radius: 0.5rem;
      background: var(--color-card);
      box-shadow: var(--shadow-popover);
      color: var(--color-text);
    }

    option {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      min-height: 2.75rem;
      padding: 0 0.75rem;
      border-radius: 0.375rem;
      font-size: 0.875rem;
      font-weight: 400;
      cursor: pointer;
    }

    option:hover,
    option:focus-visible {
      outline: none;
      background: var(--color-control);
    }

    option:checked {
      color: var(--color-accent);
      font-weight: 700;
    }

    option::checkmark {
      order: 1;
      margin-left: auto;
      content: '✓';
    }
  }
</style>

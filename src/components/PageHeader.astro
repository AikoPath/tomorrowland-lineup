---
import type { Lineup } from '../data/schema';
import { dateRangeLabel } from '../timetable/layout';

interface Props {
  lineup: Lineup;
  title: string;
}

const { lineup, title } = Astro.props;
const firstDay = lineup.days[0];
const lastDay = lineup.days.at(-1);
---

<header class="page-header">
  <p class="festival">
    Tomorrowland Thailand{firstDay && lastDay && ` · ${dateRangeLabel(firstDay.date, lastDay.date)}`}
  </p>
  <h1>{title}</h1>
</header>

<style>
  .page-header {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .festival {
    margin: 0;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.125rem;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    line-height: 1.2;
  }
</style>

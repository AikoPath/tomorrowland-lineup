---
import type { Lineup } from '../data/schema';
import { genreLabel } from '../artist-list/artist-list';
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site';
import { dayLabel, dayLabelParts, layoutDay } from '../timetable/layout';
import { LINEUP_URL, artistUrl, dayUrl } from '../urls';
import FavouriteButton from './FavouriteButton.astro';
import PageHeader from './PageHeader.astro';

interface Props {
  lineup: Lineup;
  /** `YYYY-MM-DD` of the day to show. */
  date: string;
}

const { lineup, date } = Astro.props;
const day = lineup.days.find((candidate) => candidate.date === date);
if (!day) throw new Error(`The lineup has no day ${date}`);

const otherDates = lineup.days.slice(1).map((otherDay) => otherDay.date);
const timetable = layoutDay(day, lineup.stages, lineup.artists);
---

<Base title={`Line-up ${dayLabel(date)} · ${SITE_NAME}`} mainPage="lineup">
  {
    Astro.url.pathname === LINEUP_URL && (
      <script is:inline define:vars={{ otherDates }}>
        // The en-CA locale gives the local date as YYYY-MM-DD. The stage selection in the URL stays.
        const today = new Date().toLocaleDateString('en-CA');
        if (otherDates.includes(today)) location.replace(`/${today}/${location.search}`);
      </script>
    )
  }
  <div class="page">
    <div class="title-row">
      <PageHeader lineup={lineup} title="Line-up" />
      <button
        type="button"
        class="favourites-switch"
        role="switch"
        aria-checked="false"
        aria-label="Highlight favourites"
        title="Highlight favourites"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 20.5s-7.5-4.4-7.5-10A4.3 4.3 0 0 1 12 8a4.3 4.3 0 0 1 7.5 2.5c0 5.6-7.5 10-7.5 10z"></path>
        </svg>
        <span class="track" aria-hidden="true"><span class="thumb"></span></span>
      </button>
    </div>

    <nav class="days" aria-label="Festival days">
      {
        lineup.days.map(({ date: tabDate }) => {
          const { weekday, dayAndMonth } = dayLabelParts(tabDate);
          return (
            <a href={dayUrl(tabDate)} aria-current={tabDate === date ? 'page' : undefined}>
              <span class="weekday">{weekday}</span>
              <span class="date">{dayAndMonth}</span>
            </a>
          );
        })
      }
    </nav>

    <div
      class="stage-chips"
      role="group"
      aria-label="Stages"
      data-stage-ids={lineup.stages.map(({ id }) => id).join(' ')}
    >
      <button type="button" data-stage="" aria-pressed="true">All stages</button>
      {
        timetable.columns.map(({ stage }) => (
          <button type="button" data-stage={stage.id} aria-pressed="false">
            {stage.name}
          </button>
        ))
      }
    </div>

    <p class="no-favourites" hidden>
      <span class="no-favourites-day">You have no favourites on this day.</span>
      <span class="no-favourites-stages">You have no favourites on the selected stages on this day.</span>
      Select the heart on a set to add it to your favourites.
    </p>

    <main
      class="timetable"
      data-date={date}
      style={`--stages: ${timetable.columns.length}; --length: ${timetable.length};`}
      aria-label={`Line-up ${dayLabel(date)}`}
    >
      <div class="corner"></div>
      {timetable.columns.map(({ stage }) => <h2 class="stage-name" data-stage={stage.id}>{stage.name}</h2>)}

      <ol class="hours" aria-hidden="true">
        {timetable.hours.map((hour) => <li style={`--offset: ${hour.offset}`}>{hour.label}</li>)}
      </ol>
      {
        timetable.columns.map(({ stage, sets }) => (
          <ol class="stage" data-stage={stage.id} aria-label={stage.name}>
            {sets.map((set) => (
              <li
                class:list={['set', { photo: set.image, single: set.artists.length === 1 }]}
                data-set-key={set.key}
                style={`--offset: ${set.offset}; --length: ${set.length}`}
              >
                {set.image && <img src={set.image} alt="" loading="lazy" decoding="async" />}
                <span class="artists">
                  {set.artists.map((artist, index) => (
                    <>
                      {index > 0 && <span class="b2b"> b2b </span>}
                      <a href={artistUrl(artist.id)}>{artist.name}</a>
                    </>
                  ))}
                </span>
                <span class="time">
                  <time datetime={set.start}>{set.start}</time>–<time datetime={set.end}>{set.end}</time>
                </span>
                {set.genres.length > 0 && <span class="genre">{set.genres.map(genreLabel).join(', ')}</span>}
                <FavouriteButton
                  class="set-favourite"
                  setKey={set.key}
                  subject={set.artists.map((artist) => artist.name).join(' b2b ')}
                />
              </li>
            ))}
          </ol>
        ))
      }
    </main>
  </div>
</Base>

<script>
  import { FAVOURITES_CHANGE_EVENT, readFavourites } from '../favourites/favourites.ts';
  import { isSetDimmed, readHighlight, withHighlight } from '../timetable/favourite-highlight.ts';
  import { readScrollPosition, saveScrollPosition } from '../timetable/scroll-position.ts';
  import {
    daySelection,
    isStageShown,
    readStageSelection,
    toggleStage,
    withStageSelection,
  } from '../timetable/stage-filter.ts';

  const timetable = document.querySelector<HTMLElement>('.timetable')!;
  const stageChips = document.querySelector<HTMLElement>('.stage-chips')!;
  const favouritesSwitch = document.querySelector<HTMLButtonElement>('.favourites-switch')!;
  const noFavourites = document.querySelector<HTMLElement>('.no-favourites')!;
  const chips = [...stageChips.querySelectorAll<HTMLButtonElement>('button')];
  const columns = [...timetable.querySelectorAll<HTMLElement>('[data-stage]')];
  const sets = [...timetable.querySelectorAll<HTMLElement>('.set')];
  const dayLinks = [...document.querySelectorAll<HTMLAnchorElement>('.days a')];
  const stageIds = stageChips.dataset.stageIds!.split(' ');
  const dayStageIds = chips.map((chip) => chip.dataset.stage!).filter(Boolean);
  const date = timetable.dataset.date!;

  let selection = readStageSelection(location.search, stageIds);
  let highlight = readHighlight(location.search);

  function withFilters(url: URL): URL {
    return withHighlight(withStageSelection(url, selection), highlight);
  }

  /** The sets that are favourites, in a column that shows. */
  function shownFavourites(): HTMLElement[] {
    return sets.filter((set) => !set.classList.contains('dimmed') && !set.closest<HTMLElement>('.stage')!.hidden);
  }

  function render() {
    const shown = daySelection(selection, dayStageIds);
    for (const chip of chips) {
      const stage = chip.dataset.stage!;
      const pressed = stage ? shown.includes(stage) : shown.length === 0;
      chip.setAttribute('aria-pressed', String(pressed));
    }
    for (const column of columns) column.hidden = !isStageShown(shown, column.dataset.stage!);
    const shownCount = shown.length === 0 ? dayStageIds.length : shown.length;
    timetable.style.setProperty('--stages', String(shownCount));

    favouritesSwitch.setAttribute('aria-checked', String(highlight));
    timetable.classList.toggle('highlight', highlight);
    const favourites = readFavourites(localStorage);
    for (const set of sets) set.classList.toggle('dimmed', isSetDimmed(highlight, favourites, set.dataset.setKey!));
    noFavourites.hidden = !highlight || shownFavourites().length > 0;
    noFavourites.querySelector<HTMLElement>('.no-favourites-day')!.hidden = shown.length > 0;
    noFavourites.querySelector<HTMLElement>('.no-favourites-stages')!.hidden = shown.length === 0;

    const nextUrl = withFilters(new URL(location.href));
    if (nextUrl.href !== location.href) history.replaceState(history.state, '', nextUrl);
    for (const link of dayLinks) link.href = withFilters(new URL(link.href)).href;
  }

  /** Scrolls the timetable to the earliest favourite set, below the stage names and right of the hours. */
  function scrollToFirstFavourite() {
    const [first] = shownFavourites().sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
    if (!first) return;
    const box = timetable.getBoundingClientRect();
    const set = first.getBoundingClientRect();
    const header = timetable.querySelector<HTMLElement>('.corner')!.getBoundingClientRect();
    timetable.scrollTo({
      top: timetable.scrollTop + set.top - box.top - header.height - 8,
      left: timetable.scrollLeft + set.left - box.left - header.width - 8,
      behavior: 'smooth',
    });
  }

  function saveScroll() {
    saveScrollPosition(sessionStorage, date, {
      left: timetable.scrollLeft,
      top: timetable.scrollTop,
      chipsLeft: stageChips.scrollLeft,
    });
  }

  let scrollTimer: number | undefined;
  function scheduleSaveScroll() {
    clearTimeout(scrollTimer);
    scrollTimer = setTimeout(saveScroll, 100);
  }

  function isBackNavigation(): boolean {
    const entry = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    return entry?.type === 'back_forward';
  }

  // The timetable scrolls in its own box, which browsers do not restore on a fresh load.
  function restoreScroll() {
    const saved = readScrollPosition(sessionStorage, date);
    if (saved) {
      timetable.scrollLeft = saved.left;
      timetable.scrollTop = saved.top;
      stageChips.scrollLeft = saved.chipsLeft;
    }
    if (highlight && (!saved || (saved.left === 0 && saved.top === 0 && !isBackNavigation()))) {
      scrollToFirstFavourite();
    }
  }

  // A browser cannot show some image files, for example a PSD file. Then the card has no photo.
  function removePhoto(image: HTMLImageElement) {
    image.closest('.set')?.classList.remove('photo');
    image.remove();
  }
  for (const image of timetable.querySelectorAll<HTMLImageElement>('.set img')) {
    if (image.complete && image.naturalWidth === 0) removePhoto(image);
    else image.addEventListener('error', () => removePhoto(image));
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const stage = chip.dataset.stage!;
      selection = stage ? toggleStage(selection, stage, stageIds) : [];
      render();
    });
  }
  favouritesSwitch.addEventListener('click', () => {
    highlight = !highlight;
    render();
    if (highlight) scrollToFirstFavourite();
  });
  timetable.addEventListener('scroll', scheduleSaveScroll, { passive: true });
  stageChips.addEventListener('scroll', scheduleSaveScroll, { passive: true });
  addEventListener('pagehide', () => {
    clearTimeout(scrollTimer);
    saveScroll();
  });
  addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    render();
    if (timetable.scrollLeft === 0 && timetable.scrollTop === 0) {
      const saved = readScrollPosition(sessionStorage, date);
      if (saved) {
        timetable.scrollLeft = saved.left;
        timetable.scrollTop = saved.top;
        stageChips.scrollLeft = saved.chipsLeft;
      }
    }
  });
  // A heart click, a sync with the account or a change in an other tab changes the favourite sets.
  document.addEventListener(FAVOURITES_CHANGE_EVENT, render);
  addEventListener('storage', render);
  render();
  restoreScroll();
</script>

<style>
  .page {
    display: flex;
    flex-direction: column;
    height: calc(100dvh - var(--main-nav-height));
  }

  /* The switch is next to the title. It does not make the line above the title narrower. */
  .title-row {
    position: relative;
    padding: 1.75rem 1.25rem 0;
  }

  .favourites-switch {
    position: absolute;
    right: 1.25rem;
    bottom: 0;
    display: flex;
    flex: none;
    gap: 0.5rem;
    align-items: center;
    height: 2.75rem;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .favourites-switch svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .track {
    position: relative;
    width: 2.75rem;
    height: 1.625rem;
    border-radius: 999px;
    background: var(--color-control-line);
    transition: background 150ms;
  }

  .thumb {
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: var(--color-text);
    transition: transform 150ms;
  }

  .favourites-switch[aria-checked='true'] svg {
    fill: var(--color-accent);
    stroke: var(--color-accent);
  }

  .favourites-switch[aria-checked='true'] .track {
    background: var(--color-accent);
  }

  .favourites-switch[aria-checked='true'] .thumb {
    transform: translateX(1.125rem);
  }

  @media (prefers-reduced-motion: reduce) {
    .track,
    .thumb {
      transition: none;
    }
  }

  .days {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 0.5rem;
    padding: 1rem 1.25rem 0;
  }

  .days a {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    align-items: center;
    justify-content: center;
    height: 3.5rem;
    border: 1px solid var(--color-control-line);
    border-radius: 0.5rem;
    background: var(--color-control);
    color: var(--color-text);
    text-decoration: none;
  }

  .weekday {
    font-weight: 700;
  }

  .date {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .days a[aria-current='page'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
  }

  .days a[aria-current='page'] .date {
    color: inherit;
    font-weight: 700;
  }

  .stage-chips {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding: 0.75rem 1.25rem 1rem;
    scrollbar-width: none;
  }

  .stage-chips button {
    flex: none;
    height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid var(--color-control-line);
    border-radius: 999px;
    background: transparent;
    color: var(--color-text-muted);
    font: inherit;
    font-size: 0.875rem;
    white-space: nowrap;
    cursor: pointer;
  }

  .stage-chips button[aria-pressed='true'] {
    border-color: var(--color-text);
    background: var(--color-text);
    color: var(--color-background);
    font-weight: 700;
  }

  .no-favourites {
    margin: 0;
    padding: 0.75rem 1.25rem;
    border-top: 1px solid var(--color-divider);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .no-favourites span {
    display: block;
    color: var(--color-text);
    font-weight: 700;
  }

  .no-favourites[hidden],
  .no-favourites [hidden] {
    display: none;
  }

  /*
   * The timetable scrolls in both directions in its own box.
   * Then the stage names stay at the top and the hours stay at the left on a phone.
   */
  .timetable {
    --minute: 1.6px;
    --hour-column: 3.25rem;
    --stage-column: minmax(10rem, 1fr);
    --header-row: 2.5rem;

    display: grid;
    grid-template-columns: var(--hour-column) repeat(var(--stages), var(--stage-column));
    grid-template-rows: var(--header-row) calc(var(--length) * var(--minute));
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
    border-top: 1px solid var(--color-divider);
  }

  .timetable [hidden] {
    display: none;
  }

  .corner,
  .stage-name {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--color-bar);
  }

  .corner {
    left: 0;
    z-index: 3;
  }

  .stage-name {
    display: flex;
    align-items: center;
    overflow: hidden;
    margin: 0;
    padding: 0 0.5rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hours {
    position: sticky;
    left: 0;
    z-index: 1;
    border-right: 1px solid var(--color-divider);
    background: var(--color-background);
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .hours li {
    position: absolute;
    top: calc(var(--offset) * var(--minute));
    left: 0.5rem;
    padding-top: 0.25rem;
  }

  .stage {
    background: repeating-linear-gradient(
      to bottom,
      var(--color-divider) 0,
      var(--color-divider) 1px,
      transparent 1px,
      transparent calc(60 * var(--minute))
    );
  }

  .set {
    position: absolute;
    top: calc(var(--offset) * var(--minute) + 1px);
    height: calc(var(--length) * var(--minute) - 2px);
    left: 3px;
    right: 3px;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    overflow: hidden;
    padding: 0.5rem 0.625rem;
    border-radius: 0.5rem;
    background: var(--color-card);
    font-size: 0.75rem;
  }

  /* The photo and the gradient are below the text in the stacking context of the set. */
  .set img,
  .set.photo::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .set img {
    z-index: -2;
    object-fit: cover;
    object-position: top;
  }

  .set.photo::before {
    content: '';
    z-index: -1;
    background: var(--gradient-photo);
  }

  .artists {
    /* The heart button is at the top right of the card. */
    padding-right: 1.875rem;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .artists a {
    text-decoration: none;
  }

  .artists a:hover,
  .artists a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
  }

  /* A set with one artist is a link in full. A B2B set has one link for each artist. */
  .single .artists a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .b2b {
    font-weight: 400;
  }

  .set.dimmed {
    opacity: 0.3;
    filter: grayscale(1);
  }

  /* An outline shows above the photo. A box shadow does not. */
  .highlight .set:not(.dimmed) {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  /* Above the link that covers the card. */
  .set :global(.set-favourite) {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 1;
  }

  .time {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .genre {
    color: var(--color-text-muted);
  }
</style>

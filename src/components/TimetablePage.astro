---
import type { Lineup } from '../data/schema';
import Base from '../layouts/Base.astro';
import { SITE_NAME } from '../site';
import { dayLabel, layoutDay } from '../timetable/layout';
import { ARTIST_LIST_URL, artistUrl, dayUrl } from '../urls';

interface Props {
  lineup: Lineup;
  /** `YYYY-MM-DD` of the day to show. */
  date: string;
}

const { lineup, date } = Astro.props;
const day = lineup.days.find((candidate) => candidate.date === date);
if (!day) throw new Error(`The lineup has no day ${date}`);

const firstDate = lineup.days[0].date;
const timetable = layoutDay(day, lineup.stages, lineup.artists);
---

<Base title={`Timetable ${dayLabel(date)} · ${SITE_NAME}`}>
  <div class="page">
  <header class="page-header">
    <div class="title-row">
      <h1>{SITE_NAME}</h1>
      <a href={ARTIST_LIST_URL} class="artists-link">All artists</a>
    </div>
    <nav class="days" aria-label="Festival days">
      {
        lineup.days.map(({ date: tabDate }) => (
          <a href={dayUrl(tabDate, firstDate)} aria-current={tabDate === date ? 'page' : undefined}>
            {dayLabel(tabDate)}
          </a>
        ))
      }
    </nav>
  </header>

  <main
    class="timetable"
    style={`--stages: ${timetable.columns.length}; --length: ${timetable.length};`}
    aria-label={`Timetable ${dayLabel(date)}`}
  >
    <div class="corner"></div>
    {timetable.columns.map(({ stage }) => <h2 class="stage-name">{stage.name}</h2>)}

    <ol class="hours" aria-hidden="true">
      {timetable.hours.map((hour) => <li style={`--offset: ${hour.offset}`}>{hour.label}</li>)}
    </ol>
    {
      timetable.columns.map(({ stage, sets }) => (
        <ol class="stage" aria-label={stage.name}>
          {sets.map((set) => (
            <li class="set" style={`--offset: ${set.offset}; --length: ${set.length}`}>
              <span class="artists">
                {set.artists.map((artist, index) => (
                  <>
                    {index > 0 && <span class="b2b"> b2b </span>}
                    <a href={artistUrl(artist.id)}>{artist.name}</a>
                  </>
                ))}
              </span>
              <span class="time">
                <time datetime={set.start}>{set.start}</time>–<time datetime={set.end}>{set.end}</time>
              </span>
            </li>
          ))}
        </ol>
      ))
    }
  </main>
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    height: 100dvh;
  }

  .page-header {
    padding: 0.75rem 1rem 0.5rem;
  }

  .title-row {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  h1 {
    margin: 0;
    font-size: 1.25rem;
  }

  .artists-link {
    flex: none;
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .days {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
  }

  .days a {
    flex: none;
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }

  .days a[aria-current='page'] {
    border-color: transparent;
    background: var(--gradient-accent);
  }

  /*
   * The timetable scrolls in both directions in its own box.
   * Then the stage names stay at the top and the hours stay at the left on a phone.
   */
  .timetable {
    --minute: 1.25px;
    --hour-column: 3.25rem;
    --stage-column: minmax(8.5rem, 1fr);
    --header-row: 2.75rem;

    display: grid;
    grid-template-columns: var(--hour-column) repeat(var(--stages), var(--stage-column));
    grid-template-rows: var(--header-row) calc(var(--length) * var(--minute));
    flex: 1;
    min-height: 0;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .corner,
  .stage-name {
    position: sticky;
    top: 0;
    z-index: 2;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-line);
  }

  .corner {
    left: 0;
    z-index: 3;
  }

  .stage-name {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    padding: 0 0.25rem;
    color: var(--color-accent);
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-align: center;
    text-transform: uppercase;
  }

  ol {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hours {
    position: sticky;
    left: 0;
    z-index: 1;
    background: var(--color-background);
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .hours li {
    position: absolute;
    top: calc(var(--offset) * var(--minute));
    right: 0.375rem;
    transform: translateY(-50%);
  }

  .hours li:first-child {
    transform: none;
  }

  .stage {
    border-left: 1px solid var(--color-line);
    background: repeating-linear-gradient(
      to bottom,
      var(--color-line) 0,
      var(--color-line) 1px,
      transparent 1px,
      transparent calc(60 * var(--minute))
    );
  }

  .set {
    position: absolute;
    top: calc(var(--offset) * var(--minute));
    height: calc(var(--length) * var(--minute));
    left: 0.125rem;
    right: 0.125rem;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    overflow: hidden;
    padding: 0.25rem 0.375rem;
    border: 1px solid var(--color-line);
    border-left: 3px solid var(--color-accent);
    border-radius: 0.25rem;
    background: var(--color-surface);
    font-size: 0.8125rem;
  }

  .artists a {
    font-weight: 600;
  }

  .b2b,
  .time {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
</style>
